<UserControl x:Class="AstroValley.Presentation.Controls.PageHeader"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 x:Name="Root">
    <StackPanel  Orientation="Horizontal">

        <!-- Logo -->
        <ContentControl Style="{StaticResource AppLogo}" VerticalAlignment="Center" Margin="0 0 4 0"/>
        
        <!-- Page Title-->
        <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center" />
        
        <!--<TextBlock Text="{Binding Description, ElementName=Root}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" Visibility="Collapsed" />-->
    </StackPanel>
</UserControl>
