<UserControl x:Class="AstroValley.Presentation.Controls.PageHeader"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 x:Name="Root">
    <StackPanel Margin="{StaticResource SectionMargin}">
        <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock Text="{Binding Description, ElementName=Root}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
    </StackPanel>
</UserControl>
