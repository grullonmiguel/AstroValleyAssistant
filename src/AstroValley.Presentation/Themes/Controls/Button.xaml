<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:AstroValley.Presentation.Themes.Controls">

    <Style x:Key="Theme.Button.IconOnly" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Foreground}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Button.HamburgerMenu" TargetType="Button" BasedOn="{StaticResource Theme.Button.IconOnly}">
        <Setter Property="Content">
            <Setter.Value>
                <Path Width="{StaticResource Size.Icon.Small}" 
                  Height="{StaticResource Size.Icon.Small}" 
                  Stretch="Uniform"
                  Data="{StaticResource Icon.HamburgerMenu}"
                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Button.InfoPill" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Pill.Background}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="12"
                        Padding="10,4"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Foreground}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Button.Primary" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Primary.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Primary.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Control.Primary.Foreground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="contentPresenter"
                                      Focusable="False"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Control.Primary.MouseOver}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Control.Primary.Pressed}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Control.Primary.Selected.Border}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            <Setter Property="Foreground" Value="#888888" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Real Auction brand orange (#CD7B2E) call-to-action; fixed color so it stands out from the purple UI. -->
    <Style x:Key="Theme.Button.Scrape" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#CD7B2E" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter Focusable="False" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#B96A22" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#A25C1C" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VibrantButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Subtle}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Subtle}"/>
        <Setter Property="BorderThickness" Value=".5"/>
        <Setter Property="Background" Value="#20000000"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Secondary}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Tertiary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Tertiary}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outlined secondary button: pairs with Theme.Button.Primary -->
    <Style x:Key="Theme.Button.Outline" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon + text for any button (or toggle button) style that shows its content: set ContentTemplate to this and Tag to an
         Icon.* geometry. The icon takes the button's text colour and size; with no Tag only the text shows. -->
    <DataTemplate x:Key="Theme.Button.Content.Icon">
        <StackPanel Orientation="Horizontal">
            <Path x:Name="Icon" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  Stretch="Uniform" VerticalAlignment="Center" Margin="{StaticResource Margin.Icon.Right}"/>
            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--#region Pill buttons -->
    <!-- A strip of choices or actions: put the buttons in a Border with Theme.Border.PillGroup.
         Pill = a quiet choice / secondary action; Pill.On = the selected choice / the main action. Tag = optional Icon.* geometry. -->
    <Style x:Key="Theme.Border.PillGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Pill.Background}"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style x:Key="Theme.Button.Pill" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="ContentTemplate" Value="{StaticResource Theme.Button.Content.Icon}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Secondary.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Theme.Button.Pill.On" TargetType="Button" BasedOn="{StaticResource Theme.Button.Pill}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Light}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--#endregion-->

    <!--#region Small outline buttons -->
    <!-- A compact secondary action inside a card (View on Map, an office's website, Clear Filters). Tag = optional Icon.* geometry. -->
    <Style x:Key="Theme.Button.Outline.Small" TargetType="Button" BasedOn="{StaticResource Theme.Button.Outline}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ContentTemplate" Value="{StaticResource Theme.Button.Content.Icon}"/>
    </Style>
    <!-- the same look for an on / off switch (Edit): tinted while on -->
    <Style x:Key="Theme.ToggleButton.Outline.Small" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="ContentTemplate" Value="{StaticResource Theme.Button.Content.Icon}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Secondary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--#endregion-->

    <!-- Hyperlink-like Button style -->
    <Style x:Key="Theme.Button.Hyperlink" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextBlock.TextDecorations" Value="None"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Subtle}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Transparent Border makes the whole button area clickable, not just the glyphs -->
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="{TemplateBinding TextBlock.TextDecorations}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Hyperlink.Primary.Foreground}"/>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icon-only button that follows Hyperlink colors (subtle -> primary on hover), no background -->
    <Style x:Key="Theme.Button.Hyperlink.Icon" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Subtle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Hyperlink.Primary.Foreground}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Custom Style for Icon Button -->
    <Style TargetType="{x:Type local:IconTextButton}">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource Brush.IconText.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.IconText.Foreground}"/>
        <Setter Property="Foreground"  Value="{DynamicResource Brush.IconText.Foreground}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:IconTextButton}">
                    <Border x:Name="Bd"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <!-- Center everything by default -->
                        <StackPanel x:Name="Layout"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <Path x:Name="IconPath"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Data="{TemplateBinding Icon}"
                                  Fill="{TemplateBinding Foreground}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>

                            <TextBlock x:Name="TextBlock"
                                       Text="{TemplateBinding Text}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Icon missing => collapse it; text stays centered because Layout is centered -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconPath" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IconPath" Property="Margin" Value="0"/>
                        </Trigger>

                        <!-- Text missing/empty => collapse it; icon stays centered -->
                        <Trigger Property="Text" Value="{x:Static sys:String.Empty}">
                            <Setter TargetName="TextBlock" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="TextBlock" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Typical visual states: change Foreground and the icon follows automatically -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.IconText.Background.MouseOver}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22000000"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.IconText.Foreground.MouseOver}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Button.IconText.Sidebar" TargetType="{x:Type local:IconTextButton}">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource Brush.IconText.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.IconText.Foreground}"/>
        <Setter Property="Foreground"  Value="{DynamicResource Brush.IconText.Foreground}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:IconTextButton}">
                    <Border x:Name="Bd"
                            CornerRadius="0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <!-- Center everything by default -->
                        <StackPanel x:Name="Layout"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">

                            <Path x:Name="IconPath"
                                  Width="12" Height="12"
                                  Stretch="Uniform"
                                  Data="{TemplateBinding Icon}"
                                  Fill="{TemplateBinding Foreground}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>

                            <TextBlock x:Name="TextBlock"
                                       Text="{TemplateBinding Text}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Icon missing => collapse it; text stays centered because Layout is centered -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconPath" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IconPath" Property="Margin" Value="0"/>
                        </Trigger>

                        <!-- Text missing/empty => collapse it; icon stays centered -->
                        <Trigger Property="Text" Value="{x:Static sys:String.Empty}">
                            <Setter TargetName="TextBlock" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="TextBlock" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Typical visual states: change Foreground and the icon follows automatically -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.IconText.Background.MouseOver}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22000000"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.IconText.Foreground.MouseOver}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="ToolTip" Value="Not available for the selected row"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--#region Dialog buttons -->
    <!-- Buttons of the shared dialog look (see the Dialogs region in _Resources.xaml) -->
    <!-- small text action inside a card (Copy, Remove) -->
    <Style x:Key="Theme.Dialog.Button.Link" TargetType="Button" BasedOn="{StaticResource Theme.Button.IconOnly}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>

    <Style x:Key="Theme.Dialog.Button.Outline" TargetType="Button" BasedOn="{StaticResource Theme.Button.Outline}">
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="ContentTemplate" Value="{StaticResource Theme.Button.Content.Icon}"/>
    </Style>
    <!-- the primary style has no text size of its own; match the outline button beside it -->
    <Style x:Key="Theme.Dialog.Button.Primary" TargetType="Button" BasedOn="{StaticResource Theme.Button.Primary}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Normal}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="ContentTemplate" Value="{StaticResource Theme.Button.Content.Icon}"/>
    </Style>
    <!--#endregion-->

</ResourceDictionary>