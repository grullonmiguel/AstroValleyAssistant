<UserControl x:Class="AstroValley.Presentation.Views.Pages.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstroValley.Presentation.Views"
             xmlns:vm="clr-namespace:AstroValley.Presentation.ViewModels"
             xmlns:conv="clr-namespace:AstroValley.Presentation.Converters"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <conv:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>

        <!-- State card colors follow the brand primary picked in Settings. Slate (#2C3444, like the reference map) was the alternative. -->

        <!-- Parcel rows sit on a white list, so use the accent colour. -->
        <Style x:Key="HomeCountyItem" TargetType="ListBoxItem" >
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent" SnapsToDevicePixels="true">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
                            </Trigger>
                            <!-- Selected: same dark purple as the state sidebar, white text. -->
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text-only button for use inside a pill: pill's green text colour, underlined on hover. -->
        <Style x:Key="HomePillButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent Border + the pill's padding here, so the whole pill is clickable, not just the glyphs. -->
                        <Border Background="Transparent" Padding="8 2">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Status.Success.Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bare icon button for a list row; colour comes from the Path inside, no hover background. -->
        <Style x:Key="HomePinTrash" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6 4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill chip button for the top-right map tools; the selected one is filled. -->
        <Style x:Key="HomeSegment" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Padding="12 4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#224F4486"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Chips in the top-right switch: they show the map's state. -->
        <Style x:Key="HomeChip.Terrain" TargetType="Button" BasedOn="{StaticResource HomeSegment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTerrain}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeChip.Tour" TargetType="Button" BasedOn="{StaticResource HomeSegment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTouring}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Content" Value="Stop"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeChip.Flood" TargetType="Button" BasedOn="{StaticResource HomeSegment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFlood}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeChip.Wetlands" TargetType="Button" BasedOn="{StaticResource HomeSegment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWetlands}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeChip.Epa" TargetType="Button" BasedOn="{StaticResource HomeSegment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEpa}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- Composition control (not WebView2) so WPF elements can overlay the map. -->
        <wv2:WebView2CompositionControl x:Name="MapWebView"/>

        <!-- Loading cover until the map reports ready (sidebars are declared later, so they stay on top). -->
        <Grid x:Name="MapLoading" Background="Transparent">
            <Border Width="300" Height="190" CornerRadius="16" Background="#CC1E1E1E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="56" Height="56" HorizontalAlignment="Center">
                    <Ellipse Stroke="#33FFFFFF" StrokeThickness="4"/>
                    <!-- Short rounded arc (dash 9 / gap 30 in stroke units ~ a quarter of the ring), spinning. -->
                    <Ellipse Stroke="White" StrokeThickness="4" StrokeDashArray="9 30" StrokeDashCap="Round" RenderTransformOrigin="0.5 0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <TextBlock Text="Loading map…" Margin="0 16 0 0" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Top bar, centered: search plus the pin actions. The arrow tab slides it out to the right edge and back (HomeView.SlideBar).
             Clipped so the hidden bar doesn't draw past the page. Colors follow the brand primary, like the state card. -->
        <Grid x:Name="BarArea" VerticalAlignment="Top" ClipToBounds="True" SizeChanged="OnBarAreaSizeChanged">
            <StackPanel x:Name="TopBar" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 48 0 16">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="BarShift"/>
                </StackPanel.RenderTransform>
                <Button x:Name="BarTab" Width="28" Height="32" Padding="0" Margin="0 0 2 0" VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="8"
                        Command="{Binding ToggleBarCommand}" ToolTip="Hide / show the toolbar" AutomationProperties.Name="Toggle toolbar">
                    <materialDesign:PackIcon Width="24" Height="24">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="ChevronRight"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBarOpen}" Value="False">
                                        <Setter Property="Kind" Value="ChevronLeft"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Button>
                <materialDesign:Card Padding="6" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp8"
                                     Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <!-- Same outlined button as the state card's Zoom / Details. -->
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="Margin" Value="3 0"/>
                                <Setter Property="Padding" Value="10 0"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
                                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
                                <Setter Property="materialDesign:RippleAssist.Feedback" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                            </Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Width" Value="16"/>
                                <Setter Property="Height" Value="16"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Width" Value="1"/>
                                <Setter Property="Margin" Value="4 6"/>
                                <Setter Property="Fill" Value="#4DFFFFFF"/>
                            </Style>
                        </StackPanel.Resources>

                        <!-- Search: Enter or the magnifier. Coordinates, a pin, a state, else any address / city / ZIP (online). -->
                        <Border Width="220" Height="32" Margin="3 0" Padding="10 0 2 0" CornerRadius="8" Background="#26000000">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                        Command="{Binding SearchCommand}" ToolTip="Search" AutomationProperties.Name="Search">
                                    <materialDesign:PackIcon Kind="Magnify"/>
                                </Button>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSearchKeyDown" FontSize="12"
                                         VerticalAlignment="Center" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                         CaretBrush="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                         materialDesign:HintAssist.Hint="Search location..."
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                         AutomationProperties.Name="Search location"
                                         ToolTip="An address, city, ZIP, state, parcel ID or &quot;lat, lon&quot;. Press Enter."/>
                            </DockPanel>
                        </Border>

                        <Button Command="{Binding ClearMarkersCommand}" Background="#33D64545" BorderBrush="#66D64545"
                                ToolTip="Remove all pins from the map. They stay in Load &gt; Saved pins." AutomationProperties.Name="Clear map">
                            <materialDesign:PackIcon Kind="TrashCanOutline"/>
                        </Button>
                        <Rectangle/>
                        <Button Click="OnFlyoutClicked" ToolTip="Put pins on the map: a saved set or a file">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrayArrowUp" Margin="0 0 6 0"/>
                                <TextBlock Text="Load" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="ChevronDown" Margin="6 0 0 0"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Saved pins" Command="{Binding OpenSavedPinsCommand}"
                                              ToolTip="Pins are saved automatically, one set per auction. Load a set back onto the map, or delete it."/>
                                    <MenuItem Header="Pins (JSON)" Command="{Binding LoadPinsCommand}" ToolTip="Add pins from a JSON file saved with Download &gt; Pins (JSON)."/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <!-- Filled (light on the primary bar) so it stands out, like the reference's Download. -->
                        <Button Click="OnFlyoutClicked" ToolTip="Save the pins to a file"
                                Background="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrayArrowDown" Margin="0 0 8 0"/>
                                <TextBlock Text="Download" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <materialDesign:PackIcon Kind="ChevronDown" Margin="6 0 0 0"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Pins (JSON)" Command="{Binding SavePinsCommand}"
                                              ToolTip="Everything a pin carries, so Load can read it back (another computer or a backup)."/>
                                    <MenuItem Header="GeoJSON" Command="{Binding ExportGeoJsonCommand}"
                                              ToolTip="The pins as points for other map tools (Google Earth, QGIS). Load can't read it back."/>
                                    <Separator/>
                                    <MenuItem Header="Excel" Command="{Binding ExportSheetCommand}" ToolTip="Save parcel information to an Excel file."/>
                                    <MenuItem Header="HTML map" Command="{Binding ExportMapCommand}" ToolTip="Save the current pins as a standalone HTML map."/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Rectangle/>
                        <Button Command="{Binding PlanRouteCommand}" ToolTip="Open one Google Maps driving route through the pins that are showing.">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MapMarkerPath" Margin="0 0 8 0"/>
                                <TextBlock Text="Plan Route" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </Grid>

        <!-- Bottom right, only while pins exist: map tools, then the Filters button (opens the filter dialog below). -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 0 16 40">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Markers.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <!-- Map tools parked here for now; their final home is still to be decided. -->
            <Border CornerRadius="12" Margin="0 0 8 0" Background="{DynamicResource Brush.Pill.Background}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="3D" Command="{Binding ToggleTerrainCommand}"
                                ToolTip="Tilt the map and show terrain (switches from the globe to a flat map)"/>
                        <Button Content="Tour" Command="{Binding ToggleTourCommand}"
                                ToolTip="Fly through the pins one by one in 3D. Click the map to stop."/>
                        <Rectangle Width="1" Height="18" Margin="4 0" Fill="{DynamicResource Brush.Accent}" Opacity="0.3"/>
                        <!-- Due-diligence layers; with one on, clicking the map shows what is at that spot. -->
                        <Button Content="Flood" Command="{Binding ToggleOverlayCommand}" CommandParameter="flood"
                                ToolTip="FEMA flood zones (draws when zoomed in to about street level). Click the map to see the zone at that spot."/>
                        <Button Content="Wetlands" Command="{Binding ToggleOverlayCommand}" CommandParameter="wetlands"
                                ToolTip="National Wetlands Inventory (draws from about county zoom). Click the map to see the wetland type at that spot."/>
                        <Button Content="EPA" Command="{Binding ToggleOverlayCommand}" CommandParameter="epa"
                                ToolTip="EPA Superfund (magenta) and brownfield (brown) sites. Shows when zoomed in to about county level; click a dot for details."/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border CornerRadius="12" Background="{DynamicResource Brush.Pill.Background}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.35"/>
                </Border.Effect>
                <Button Command="{Binding OpenToolsCommand}"
                        ToolTip="Filter the pins: bid, assessed value, acres, slope, type">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Stretch="Uniform" Margin="0 0 6 0" VerticalAlignment="Center"
                              Fill="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="Filters" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>
        </StackPanel>

        <!-- Left side: the selected state's sidebar (full height, styled like the shell's), then the parcel list. -->
        <!-- Clipped so the collapsed card (negative margin) stays off-screen instead of drawing over the shell. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" ClipToBounds="True">

            <!-- Floating state card: shows while a state is selected on the map; ✕ deselects it, the arrow tab slides it out/in (state stays selected). -->
            <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Top" 
                        Margin="0 48 0 0"
                        Visibility="{Binding SelectedState, Converter={StaticResource NullToVisibilityConverter}}">
                <materialDesign:Card Width="200" 
                             Padding="16 16 8 20"
                             UniformCornerRadius="14" 
                             materialDesign:ElevationAssist.Elevation="Dp8"
                             Background="{DynamicResource MaterialDesign.Brush.Primary}" 
                             Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}">
                    <materialDesign:Card.Style>
                        <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                            <!-- Collapsed: -Width, so the card sits just off the left edge and the arrow tab lands at x=0. -->
                            <Setter Property="Margin" Value="-280 0 0 0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarOpen}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" To="16 0 0 0"
                                                                Duration="{StaticResource SidebarAnimationDuration}" EasingFunction="{StaticResource StandardEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" To="-280 0 0 0"
                                                                Duration="{StaticResource SidebarAnimationDuration}" EasingFunction="{StaticResource StandardEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:Card.Style>
                    <DockPanel>
                        <!-- Details: county count tile + the state's counties (picking one highlights it on the map). Docked before the buttons so it sits below them.
                             Expands/collapses by animating ScaleY (WPF can't animate Height to Auto); LayoutTransform makes the card grow with it. -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <StackPanel.LayoutTransform>
                                <ScaleTransform ScaleY="0"/>
                            </StackPanel.LayoutTransform>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="LayoutTransform.ScaleY" To="1"
                                                                         Duration="{StaticResource SidebarAnimationDuration}" EasingFunction="{StaticResource StandardEase}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="LayoutTransform.ScaleY" To="0"
                                                                         Duration="{StaticResource SidebarAnimationDuration}" EasingFunction="{StaticResource StandardEase}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <!-- County count tile (shaded, rounded). -->
                            <Border Margin="0 12 12 0" Padding="10 6" CornerRadius="8" Background="#26000000">
                                <StackPanel>
                                    <TextBlock Text="COUNTIES" FontSize="10" FontWeight="SemiBold" Opacity="0.7"/>
                                    <TextBlock Text="{Binding SelectedState.CountyCount}" FontSize="15" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <!-- MaxHeight = how tall the expanded county list gets before it scrolls. -->
                            <ListBox Margin="0 8 12 0" MaxHeight="240"
                                 ItemsSource="{Binding Counties}"
                                 SelectedItem="{Binding SelectedCounty, Mode=TwoWay}"
                                 SelectionChanged="OnCountySelectionChanged"
                                 Style="{StaticResource NavListBoxStyle}"
                                 ScrollViewer.CanContentScroll="False">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListBoxItemStyle}">
                                        <Setter Property="Height" Value="32"/>
                                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="8 0" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <!-- Docked first so the buttons span the full width under the header; right margin evens out the card's smaller right padding. -->
                        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0 16 12 0">
                            <UniformGrid.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                    <Setter Property="Height" Value="40"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                    <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
                                    <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
                                    <Setter Property="materialDesign:RippleAssist.Feedback" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                </Style>
                            </UniformGrid.Resources>
                            <Button Content="Zoom" Margin="0 0 6 0" Command="{Binding ZoomToStateCommand}" ToolTip="Zoom the map to this state"/>
                            <Button Content="Details" Margin="6 0 0 0" Command="{Binding ToggleDetailsCommand}" ToolTip="Show / hide this state's counties"/>
                        </UniformGrid>
                        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource MaterialDesignIconButton}"
                            Width="36" Height="36" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                            Command="{Binding ClearStateCommand}" ToolTip="Close" AutomationProperties.Name="Close state card">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                        </Button>
                        <StackPanel Margin="0 2 0 0">
                            <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" Text="{Binding SelectedState.Name}"/>
                            <!-- Medium-emphasis secondary line, like "United States" in the reference. -->
                            <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}" Opacity="0.7" Margin="0 2 0 0"
                                   Text="{Binding SelectedState.TaxStatus, Converter={StaticResource EnumToDescriptionConverter}}"/>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:Card>
                <Button Width="28" Height="32" Padding="0" Margin="2 18 0 0" VerticalAlignment="Top"
                Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="8"
                Command="{Binding ToggleSidebarCommand}" ToolTip="Hide / show the state card" AutomationProperties.Name="Toggle state card">
                    <materialDesign:PackIcon Width="24" Height="24">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="ChevronRight"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarOpen}" Value="True">
                                        <Setter Property="Kind" Value="ChevronLeft"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Button>
            </StackPanel>

            <!-- Parcels sent from Real Auction / Regrid; click a row to fly to it. Hidden until pins exist. -->
            <Grid Width="155" Margin="8 86 0 24">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Markers.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="#90FFFFFF" CornerRadius="12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Accent}" CornerRadius="12 12 0 0" Margin="0 0 0 4" Padding="12 10 12 8">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="12" Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Markers.Count, StringFormat='Total Properties: {0}'}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Markers.Count}" Value="1">
                                                    <Setter Property="Text" Value="Total Properties: 1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <ListBox ItemsSource="{Binding Markers}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource HomeCountyItem}">
                                    <!-- Click (not selection change) so re-clicking the same parcel flies back to it. -->
                                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnParcelClicked"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="PinRow" Background="Transparent" ToolTip="{Binding Address}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding ParcelID}"/>
                                                    <!-- a pin added from a search has no parcel ID until it is looked up in Regrid -->
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ParcelID}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{Binding Address}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Purple dot: the legal description suggests undivided interest / co-owners. -->
                                        <Ellipse Grid.Column="1" Width="9" Height="9" Margin="6 0 0 0" Fill="#8E44AD" Stroke="White" StrokeThickness="1"
                                         ToolTip="Possible undivided interest (see legal description)"
                                         Visibility="{Binding UndividedInterest, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <!-- Road access flag from the popup's "Check if landlocked": green road / amber near / red possibly landlocked; hidden until checked. -->
                                        <Ellipse Grid.Column="2" Width="9" Height="9" Margin="6 0 2 0" Stroke="White" StrokeThickness="1"
                                         ToolTip="{Binding AccessText}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AccessStatus}" Value="Road">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Fill" Value="#2E9E5B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccessStatus}" Value="Near">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Fill" Value="#CD7B2E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccessStatus}" Value="None">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Fill" Value="#D64545"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <!-- Trash can follows the row's text colour (accent, or white on the selected row); shown on hover only. -->
                                        <Button x:Name="PinRemove" Grid.Column="3" Opacity="0" ToolTip="Remove pin"
                                        Style="{StaticResource HomePinTrash}"
                                        Command="{Binding DataContext.RemoveMarkerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                        </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="PinRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PinRemove" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

            </Grid>
        </StackPanel>

        <!-- Tools dialog: filters with from / to boxes. The count follows every edit; Show applies them to the map and list. -->
        <Grid Background="#80000000" Visibility="{Binding IsToolsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Resources>
                <Style TargetType="TextBox" >
                    <Setter Property="Padding" Value="6 4"/>
                    <Setter Property="FontSize" Value="13"/>
                </Style>
                <Style x:Key="ToolsLabel" TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Margin" Value="0 0 0 4"/>
                </Style>
                <Style x:Key="ToolsRow" TargetType="StackPanel">
                    <Setter Property="Margin" Value="0 0 16 16"/>
                </Style>
            </Grid.Resources>
            <Border Width="620" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="14"
                    Background="White" Padding="24 16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0 0 0 12">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseToolsCommand}" ToolTip="Close without applying"/>
                        <TextBlock Text="Filters" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"/>
                    </DockPanel>
                    <Border DockPanel.Dock="Top" CornerRadius="8" Padding="0 6" Margin="0 0 0 16" Background="{DynamicResource Brush.Pill.Background}">
                        <TextBlock HorizontalAlignment="Center" FontSize="15" Foreground="{DynamicResource Brush.Accent}">
                            <Run Text="Matching Properties:"/> <Run FontWeight="Bold" Text="{Binding MatchCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <!-- Actions at the bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 8 0 0">
                        <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" Margin="0 0 8 0"/>
                        <Button Content="Show" Command="{Binding ApplyToolsCommand}" MinWidth="100"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <UniformGrid Columns="2">
                            <StackPanel>
                                <TextBlock Text="Minimum Bid ($)" Style="{StaticResource ToolsLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Draft.MinBid, UpdateSourceTrigger=PropertyChanged}" ToolTip="From (blank = no limit)"/>
                                    <TextBlock Grid.Column="1" Text="to" Margin="8 0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding Draft.MaxBid, UpdateSourceTrigger=PropertyChanged}" ToolTip="To (blank = no limit). Pins with no bid are hidden while a limit is set."/>
                                </Grid>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Assessed Value ($)" Style="{StaticResource ToolsLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Draft.MinAssessed, UpdateSourceTrigger=PropertyChanged}" ToolTip="From (blank = no limit)"/>
                                    <TextBlock Grid.Column="1" Text="to" Margin="8 0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding Draft.MaxAssessed, UpdateSourceTrigger=PropertyChanged}" ToolTip="To (blank = no limit)"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Bid % of Assessed" Style="{StaticResource ToolsLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Draft.MinBidPercent, UpdateSourceTrigger=PropertyChanged}" ToolTip="From (blank = no limit)"/>
                                    <TextBlock Grid.Column="1" Text="to" Margin="8 0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding Draft.MaxBidPercent, UpdateSourceTrigger=PropertyChanged}" ToolTip="To (blank = no limit). Pins missing the bid or the assessed value are hidden."/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Style="{StaticResource ToolsRow}">
                                <TextBlock Text="Acres" Style="{StaticResource ToolsLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Draft.MinAcres, UpdateSourceTrigger=PropertyChanged}" ToolTip="From (blank = no limit)"/>
                                    <TextBlock Grid.Column="1" Text="to" Margin="8 0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding Draft.MaxAcres, UpdateSourceTrigger=PropertyChanged}" ToolTip="To (blank = no limit)"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Style="{StaticResource ToolsRow}">
                                <TextBlock Text="Slope %" Style="{StaticResource ToolsLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Draft.MinSlope, UpdateSourceTrigger=PropertyChanged}" ToolTip="From (blank = no limit). 10 and up is steep."/>
                                    <TextBlock Grid.Column="1" Text="to" Margin="8 0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding Draft.MaxSlope, UpdateSourceTrigger=PropertyChanged}" ToolTip="To (blank = no limit)"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Style="{StaticResource ToolsRow}">
                                <TextBlock Text="Property Type" Style="{StaticResource ToolsLabel}"/>
                                <ComboBox ItemsSource="{x:Static vm:PinFilter.Types}" SelectedItem="{Binding Draft.PropertyType}"
                                          ToolTip="Vacant land or Structures hides pins whose type is unknown."/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource ToolsRow}">
                                <TextBlock Text="My Properties" Style="{StaticResource ToolsLabel}"/>
                                <ComboBox ItemsSource="{x:Static vm:PinFilter.OwnedOptions}" SelectedItem="{Binding Draft.Owned}"
                                          ToolTip="The gold pins are properties you already bought."/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource ToolsRow}">
                                <TextBlock Text="Co-ownership" Style="{StaticResource ToolsLabel}"/>
                                <CheckBox Content="Possible undivided interest only" IsChecked="{Binding Draft.UndividedOnly}"
                                          ToolTip="Legal description mentions undivided / fractional / partial interest or tenants in common."/>
                            </StackPanel>
                        </UniformGrid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Shown while an export runs (IsScraping / ProgressText on the view model). -->
        <local:ScrapeOverlay/>
    </Grid>
</UserControl>
