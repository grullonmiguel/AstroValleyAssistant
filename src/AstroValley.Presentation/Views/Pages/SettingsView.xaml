<UserControl x:Class="AstroValley.Presentation.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AstroValley.Presentation.Controls">
    <StackPanel Margin="{StaticResource PagePadding}" >
        <materialDesign:Card DockPanel.Dock="Top" Style="{StaticResource SectionCardStyle}" Margin="{StaticResource PageHeaderCardMargin}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:PageHeader Title="Settings" />
            </Grid>
        </materialDesign:Card>
        <!--<controls:PageHeader Title="Settings"
                             Description="Pick a primary color. The whole app changes immediately and the choice is remembered." />-->

        <TextBlock Margin="0,0,0,12"
                   Text="Primary color" 
                   Style="{StaticResource SubtitleTextStyle}"  />

        <ItemsControl ItemsSource="{Binding ColorOptions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource SwatchButtonStyle}"
                            Background="{Binding Brush}"
                            ToolTip="{Binding Name}"
                            AutomationProperties.Name="{Binding Name}"
                            Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}">
                        <materialDesign:PackIcon Kind="Check"
                                                 Width="20"
                                                 Height="20"
                                                 Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
