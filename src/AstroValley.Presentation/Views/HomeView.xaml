<UserControl x:Class="AstroValley.Presentation.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstroValley.Presentation.Views"
             xmlns:vm="clr-namespace:AstroValley.Presentation.ViewModels"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <!-- Theme hamburger icon, with a soft white hover/press tint that suits the purple sidebar. -->
        <Style x:Key="SidebarToggleButton" TargetType="Button" BasedOn="{StaticResource Theme.Button.HamburgerMenu}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- County rows sit on a white list, so use the accent colour instead of the state list's pale text. -->
        <Style x:Key="HomeCountyItem" TargetType="ListBoxItem" BasedOn="{StaticResource Theme.ListBoxItem.StateList}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent" SnapsToDevicePixels="true">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
                            </Trigger>
                            <!-- Selected: same dark purple as the state sidebar, white text. -->
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text-only button for use inside a pill: pill's green text colour, underlined on hover. -->
        <Style x:Key="HomePillButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent Border + the pill's padding here, so the whole pill is clickable, not just the glyphs. -->
                        <Border Background="Transparent" Padding="8 2">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Status.Success.Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bare icon button for a list row; colour comes from the Path inside, no hover background. -->
        <Style x:Key="HomePinTrash" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6 4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Map | Satellite switch: two buttons that read as one rounded control; selected one is filled. -->
        <Style x:Key="HomeSegment" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Padding="12 4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#224F4486"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeSegment.Map" TargetType="Button" BasedOn="{StaticResource HomeSegment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsImagery}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeSegment.Satellite" TargetType="Button" BasedOn="{StaticResource HomeSegment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsImagery}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Chips in the top-right switch: they show the map's state. -->
        <Style x:Key="HomeChip.Terrain" TargetType="Button" BasedOn="{StaticResource HomeSegment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTerrain}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeChip.Tour" TargetType="Button" BasedOn="{StaticResource HomeSegment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTouring}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Content" Value="Stop"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeChip.Flood" TargetType="Button" BasedOn="{StaticResource HomeSegment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFlood}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeChip.Wetlands" TargetType="Button" BasedOn="{StaticResource HomeSegment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWetlands}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeChip.Epa" TargetType="Button" BasedOn="{StaticResource HomeSegment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEpa}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- Composition control (not WebView2) so WPF elements can overlay the map. -->
        <wv2:WebView2CompositionControl x:Name="MapWebView"/>

        <!-- Loading cover until the map reports ready (sidebars are declared later, so they stay on top). -->
        <Grid x:Name="MapLoading" Background="Transparent">
            <Border Width="300" Height="190" CornerRadius="16" Background="#CC1E1E1E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="56" Height="56" HorizontalAlignment="Center">
                    <Ellipse Stroke="#33FFFFFF" StrokeThickness="4"/>
                    <!-- Short rounded arc (dash 9 / gap 30 in stroke units ~ a quarter of the ring), spinning. -->
                    <Ellipse Stroke="White" StrokeThickness="4" StrokeDashArray="9 30" StrokeDashCap="Round" RenderTransformOrigin="0.5 0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <TextBlock Text="Loading map…" Margin="0 16 0 0" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Base map switch, top right. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 86 24 0">
            <Border CornerRadius="12" Background="{DynamicResource Brush.Pill.Background}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Map" Style="{StaticResource HomeSegment.Map}" Command="{Binding ShowMapCommand}"/>
                    <Button Content="Satellite" Style="{StaticResource HomeSegment.Satellite}" Command="{Binding ShowSatelliteCommand}"/>
                    <!-- Map tools: only while pins exist. -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Markers.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Rectangle Width="1" Height="18" Margin="4 0" Fill="{DynamicResource Brush.Accent}" Opacity="0.3"/>
                        <Button Content="3D" Style="{StaticResource HomeChip.Terrain}" Command="{Binding ToggleTerrainCommand}"
                                ToolTip="Tilt the map and show terrain (switches from the globe to a flat map)"/>
                        <Button Content="Tour" Style="{StaticResource HomeChip.Tour}" Command="{Binding ToggleTourCommand}"
                                ToolTip="Fly through the pins one by one in 3D. Click the map to stop."/>
                        <Rectangle Width="1" Height="18" Margin="4 0" Fill="{DynamicResource Brush.Accent}" Opacity="0.3"/>
                        <!-- Due-diligence layers; with one on, clicking the map shows what is at that spot. -->
                        <Button Content="Flood" Style="{StaticResource HomeChip.Flood}" Command="{Binding ToggleOverlayCommand}" CommandParameter="flood"
                                ToolTip="FEMA flood zones (draws when zoomed in to about street level). Click the map to see the zone at that spot."/>
                        <Button Content="Wetlands" Style="{StaticResource HomeChip.Wetlands}" Command="{Binding ToggleOverlayCommand}" CommandParameter="wetlands"
                                ToolTip="National Wetlands Inventory (draws from about county zoom). Click the map to see the wetland type at that spot."/>
                        <Button Content="EPA" Style="{StaticResource HomeChip.Epa}" Command="{Binding ToggleOverlayCommand}" CommandParameter="epa"
                                ToolTip="EPA Superfund (magenta) and brownfield (brown) sites. Shows when zoomed in to about county level; click a dot for details."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Pins menu: save / load pins as JSON, export the standalone HTML map. -->
            <Border Margin="8 0 0 0" CornerRadius="12" Background="{DynamicResource Brush.Pill.Background}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.35"/>
                </Border.Effect>
                <Button x:Name="MenuButton" Style="{StaticResource HomeSegment}" ToolTip="Pins menu" Click="OnMenuClicked">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource Brush.Accent}" Data="{StaticResource Icon.DotsVertical}"/>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="PinsMenu" Placement="Bottom">
                            <MenuItem Header="Clear Map" Command="{Binding ClearMarkersCommand}"
                                      ToolTip="Remove all pins from the map.">
                                <MenuItem.Icon>
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.Delete}"
                                          Fill="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Plan Route" Command="{Binding PlanRouteCommand}"
                                      ToolTip="Open one Google Maps driving route through the pins that are showing.">
                                <MenuItem.Icon>
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.MapMarker}"
                                          Fill="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Import Pins" Command="{Binding LoadPinsCommand}"
                                      ToolTip="Add pins from a JSON file.">
                                <MenuItem.Icon>
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.TrayDown}"
                                          Fill="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Export Pins" Command="{Binding SavePinsCommand}"
                                      ToolTip="Save the current pins to a JSON file.">
                                <MenuItem.Icon>
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.Save}"
                                          Fill="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Export Excel" Command="{Binding ExportSheetCommand}"
                                      ToolTip="Save parcel information to an Excel file.">
                                <MenuItem.Icon>
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.Excel}"
                                          Fill="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Export HTML" Command="{Binding ExportMapCommand}"
                                      ToolTip="Save the current pins as a standalone HTML map.">
                                <MenuItem.Icon>
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.Html}"
                                          Fill="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Border>
        </StackPanel>

        <!-- Tools button, bottom right; only while pins exist. Opens the filter dialog below. -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 0 16 40" CornerRadius="12" Background="{DynamicResource Brush.Pill.Background}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.35"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Markers.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Button Style="{StaticResource HomeSegment}" Command="{Binding OpenToolsCommand}"
                    ToolTip="Filter the pins: bid, assessed value, acres, slope, type">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" Stretch="Uniform" Margin="0 0 6 0" VerticalAlignment="Center"
                          Fill="{DynamicResource Brush.Accent}" Data="{StaticResource Icon.Cog}"/>
                    <TextBlock Text="Filters" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Border>

        <!-- Left side: state sidebar, then the county list of the selected state to its right. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="40 86 0 24">
        <!-- State sidebar: sits below the header like the Maps state list; collapses to a narrow strip. -->
        <Border Background="{DynamicResource Brush.Accent}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="195"/>
                    <Setter Property="ClipToBounds" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarOpen}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="36" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="195" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Width="36" Height="36"
                        Style="{StaticResource SidebarToggleButton}"
                        ToolTip="Collapse / expand"
                        Command="{Binding ToggleSidebarCommand}">
                    <Path Width="{StaticResource Size.Icon.Small}" Height="{StaticResource Size.Icon.Small}"
                          Stretch="Uniform" Fill="White"
                          Data="{StaticResource Icon.HamburgerMenu}"/>
                </Button>
                <!-- States: full name when expanded, two-letter code when collapsed. -->
                <ListBox Style="{StaticResource Theme.ListBox.BaseMapList}"
                         ItemsSource="{Binding States}"
                         SelectedItem="{Binding SelectedState, Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- Defaults are setters (a local Text would beat the trigger). Collapsed: code, centred within the item padding. -->
                                        <Setter Property="Text" Value="{Binding Abbreviation}"/>
                                        <Setter Property="Margin" Value="-6,0"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Text" Value="{Binding Name}"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Counties of the selected state (names come from the map's county GeoJSON); hidden when no state is selected. -->
        <Grid Width="155" Margin="8 0 0 0">
            <Grid.Style>
                <!-- Collapse the whole slot (not just the panel) so the parcel list closes up against the state sidebar. -->
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedState}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        <Border Background="#90FFFFFF" CornerRadius="12">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedState}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <!-- Header: "75 counties" with a divider underneath. -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Accent}" CornerRadius="12 12 0 0" Margin="0 0 0 4" Padding="12 10 12 8">
                    <StackPanel>
                    <Border HorizontalAlignment="Left" Margin="0 0 0 8" CornerRadius="10" Padding="8 2" Background="{DynamicResource Brush.Status.Success}">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Status.Success.Foreground}"
                                   Text="{Binding SelectedState.TaxStatus, Converter={StaticResource EnumToDescriptionConverter}}"/>
                    </Border>
                    <TextBlock FontWeight="Bold" FontSize="12" Foreground="White">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding SelectedState.CountyCount, StringFormat='Total Counties: {0}'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedState.CountyCount}" Value="1">
                                        <Setter Property="Text" Value="Total Counties: 1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding Counties}"
                         SelectedItem="{Binding SelectedCounty, Mode=TwoWay}"
                         DisplayMemberPath="Name"
                         ItemContainerStyle="{StaticResource HomeCountyItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"/>
            </DockPanel>
        </Border>

        </Grid>

        <!-- Parcels sent from Real Auction / Regrid: same look as the county list; click a row to fly to it. Hidden until pins exist. -->
        <Grid Width="155" Margin="8 0 0 0">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Markers.Count}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border Background="#90FFFFFF" CornerRadius="12">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Accent}" CornerRadius="12 12 0 0" Margin="0 0 0 4" Padding="12 10 12 8">
                    <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="12" Foreground="White">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Markers.Count, StringFormat='Total Properties: {0}'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Markers.Count}" Value="1">
                                        <Setter Property="Text" Value="Total Properties: 1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding Markers}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource HomeCountyItem}">
                            <!-- Click (not selection change) so re-clicking the same parcel flies back to it. -->
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnParcelClicked"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="PinRow" Background="Transparent" ToolTip="{Binding Address}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ParcelID}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <!-- Purple dot: the legal description suggests undivided interest / co-owners. -->
                                <Ellipse Grid.Column="1" Width="9" Height="9" Margin="6 0 0 0" Fill="#8E44AD" Stroke="White" StrokeThickness="1"
                                         ToolTip="Possible undivided interest (see legal description)"
                                         Visibility="{Binding UndividedInterest, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <!-- Road access flag from the popup's "Check if landlocked": green road / amber near / red possibly landlocked; hidden until checked. -->
                                <Ellipse Grid.Column="2" Width="9" Height="9" Margin="6 0 2 0" Stroke="White" StrokeThickness="1"
                                         ToolTip="{Binding AccessText}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AccessStatus}" Value="Road">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Fill" Value="#2E9E5B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AccessStatus}" Value="Near">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Fill" Value="#CD7B2E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AccessStatus}" Value="None">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Fill" Value="#D64545"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <!-- Trash can follows the row's text colour (accent, or white on the selected row); shown on hover only. -->
                                <Button x:Name="PinRemove" Grid.Column="3" Opacity="0" ToolTip="Remove pin"
                                        Style="{StaticResource HomePinTrash}"
                                        Command="{Binding DataContext.RemoveMarkerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icon.Delete}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="PinRow" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PinRemove" Property="Opacity" Value="1"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        </Grid>
        </StackPanel>

        <!-- Tools dialog: filters with from / to boxes. The count follows every edit; Show applies them to the map and list. -->
        <Grid Background="#80000000" Visibility="{Binding IsToolsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Resources>
                <Style TargetType="TextBox" BasedOn="{StaticResource Theme.TextBox}">
                    <Setter Property="Padding" Value="6 4"/>
                    <Setter Property="FontSize" Value="13"/>
                </Style>
                <Style x:Key="ToolsLabel" TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Margin" Value="0 0 0 4"/>
                </Style>
                <Style x:Key="ToolsRow" TargetType="StackPanel">
                    <Setter Property="Margin" Value="0 0 16 16"/>
                </Style>
            </Grid.Resources>
            <Border Width="620" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="14"
                    Background="White" Padding="24 16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0 0 0 12">
                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource HomeSegment}" Command="{Binding CloseToolsCommand}" ToolTip="Close without applying"/>
                        <TextBlock Text="Filters" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"/>
                    </DockPanel>
                    <Border DockPanel.Dock="Top" CornerRadius="8" Padding="0 6" Margin="0 0 0 16" Background="{DynamicResource Brush.Pill.Background}">
                        <TextBlock HorizontalAlignment="Center" FontSize="15" Foreground="{DynamicResource Brush.Accent}">
                            <Run Text="Matching Properties:"/> <Run FontWeight="Bold" Text="{Binding MatchCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <!-- Actions at the bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 8 0 0">
                        <Button Content="Clear Filters" Style="{StaticResource Theme.Button.Outline}" Command="{Binding ClearFiltersCommand}" Margin="0 0 8 0"/>
                        <Button Content="Show" Style="{StaticResource Theme.Button.Primary}" Command="{Binding ApplyToolsCommand}" MinWidth="100"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <UniformGrid Columns="2">
                            <StackPanel Style="{StaticResource ToolsRow}">
                                <TextBlock Text="Minimum Bid ($)" Style="{StaticResource ToolsLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Draft.MinBid, UpdateSourceTrigger=PropertyChanged}" ToolTip="From (blank = no limit)"/>
                                    <TextBlock Grid.Column="1" Text="to" Margin="8 0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding Draft.MaxBid, UpdateSourceTrigger=PropertyChanged}" ToolTip="To (blank = no limit). Pins with no bid are hidden while a limit is set."/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Style="{StaticResource ToolsRow}">
                                <TextBlock Text="Assessed Value ($)" Style="{StaticResource ToolsLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Draft.MinAssessed, UpdateSourceTrigger=PropertyChanged}" ToolTip="From (blank = no limit)"/>
                                    <TextBlock Grid.Column="1" Text="to" Margin="8 0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding Draft.MaxAssessed, UpdateSourceTrigger=PropertyChanged}" ToolTip="To (blank = no limit)"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Style="{StaticResource ToolsRow}">
                                <TextBlock Text="Bid % of Assessed" Style="{StaticResource ToolsLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Draft.MinBidPercent, UpdateSourceTrigger=PropertyChanged}" ToolTip="From (blank = no limit)"/>
                                    <TextBlock Grid.Column="1" Text="to" Margin="8 0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding Draft.MaxBidPercent, UpdateSourceTrigger=PropertyChanged}" ToolTip="To (blank = no limit). Pins missing the bid or the assessed value are hidden."/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Style="{StaticResource ToolsRow}">
                                <TextBlock Text="Acres" Style="{StaticResource ToolsLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Draft.MinAcres, UpdateSourceTrigger=PropertyChanged}" ToolTip="From (blank = no limit)"/>
                                    <TextBlock Grid.Column="1" Text="to" Margin="8 0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding Draft.MaxAcres, UpdateSourceTrigger=PropertyChanged}" ToolTip="To (blank = no limit)"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Style="{StaticResource ToolsRow}">
                                <TextBlock Text="Slope %" Style="{StaticResource ToolsLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Draft.MinSlope, UpdateSourceTrigger=PropertyChanged}" ToolTip="From (blank = no limit). 10 and up is steep."/>
                                    <TextBlock Grid.Column="1" Text="to" Margin="8 0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding Draft.MaxSlope, UpdateSourceTrigger=PropertyChanged}" ToolTip="To (blank = no limit)"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Style="{StaticResource ToolsRow}">
                                <TextBlock Text="Property Type" Style="{StaticResource ToolsLabel}"/>
                                <ComboBox ItemsSource="{x:Static vm:PinFilter.Types}" SelectedItem="{Binding Draft.PropertyType}"
                                          ToolTip="Vacant land or Structures hides pins whose type is unknown."/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource ToolsRow}">
                                <TextBlock Text="Co-ownership" Style="{StaticResource ToolsLabel}"/>
                                <CheckBox Content="Possible undivided interest only" IsChecked="{Binding Draft.UndividedOnly}"
                                          ToolTip="Legal description mentions undivided / fractional / partial interest or tenants in common."/>
                            </StackPanel>
                        </UniformGrid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Shown while an export runs (IsScraping / ProgressText on the view model). -->
        <local:ScrapeOverlay/>
    </Grid>
</UserControl>
