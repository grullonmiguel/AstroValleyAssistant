<UserControl x:Class="AstroValley.Presentation.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <!-- Theme hamburger icon, with a soft white hover/press tint that suits the purple sidebar. -->
        <Style x:Key="SidebarToggleButton" TargetType="Button" BasedOn="{StaticResource Theme.Button.HamburgerMenu}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Type pill: same status colours as Maps, but always a filled pill so it reads on top of the map. -->
        <Style x:Key="HomeTaxStatusPill" TargetType="ContentControl" BasedOn="{StaticResource Theme.Control.TaxStatusPill}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="12" Padding="10,4" Background="{DynamicResource Brush.Pill.Background}">
                            <ContentPresenter TextElement.Foreground="{DynamicResource Brush.Accent}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- Composition control (not WebView2) so WPF elements can overlay the map. -->
        <wv2:WebView2CompositionControl x:Name="MapWebView"/>

        <!-- Selected-state info pills, top right. WPF (not HTML) so they use the app theme and bind to SelectedState. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0 86 24 0"
                    DataContext="{Binding SelectedState}"
                    Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.35"/>
            </StackPanel.Effect>
            <ContentControl Style="{StaticResource HomeTaxStatusPill}">
                <TextBlock>
                    <Run Text="Type:" FontWeight="SemiBold"/>
                    <Run Text="{Binding TaxStatus, Converter={StaticResource EnumToDescriptionConverter}, StringFormat='{} {0}'}"/>
                </TextBlock>
            </ContentControl>
            <ContentControl Style="{StaticResource Theme.Control.CountyInfoPill}" Margin="8,0,0,0">
                <TextBlock>
                    <Run Text="Counties:" FontWeight="SemiBold"/>
                    <Run Text="{Binding CountyCount}"/>
                </TextBlock>
            </ContentControl>
        </StackPanel>

        <!-- Left sidebar: sits below the header like the Maps state list; collapses to a narrow strip. -->
        <Border HorizontalAlignment="Left" Margin="40 86 0 24"
                Background="{DynamicResource Brush.Accent}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="200"/>
                    <Setter Property="ClipToBounds" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarOpen}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="36" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="200" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Width="36" Height="36"
                        Style="{StaticResource SidebarToggleButton}"
                        ToolTip="Collapse / expand"
                        Command="{Binding ToggleSidebarCommand}">
                    <Path Width="{StaticResource Size.Icon.Small}" Height="{StaticResource Size.Icon.Small}"
                          Stretch="Uniform" Fill="White"
                          Data="{StaticResource Icon.HamburgerMenu}"/>
                </Button>
                <!-- States: full name when expanded, two-letter code when collapsed. -->
                <ListBox Style="{StaticResource Theme.ListBox.BaseMapList}"
                         ItemsSource="{Binding States}"
                         SelectedItem="{Binding SelectedState, Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- Defaults are setters (a local Text would beat the trigger). Collapsed: code, centred within the item padding. -->
                                        <Setter Property="Text" Value="{Binding Abbreviation}"/>
                                        <Setter Property="Margin" Value="-6,0"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Text" Value="{Binding Name}"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
