<UserControl x:Class="AstroValley.Presentation.Views.Dialogs.ResolveMatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstroValley.Presentation.Views.Dialogs"
             Width="760">

    <UserControl.Resources>

        <Style x:Key="Match.Icon" TargetType="Path">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.Accent}"/>
        </Style>

        <Style x:Key="Match.Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>

        <Style x:Key="Match.Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>

        <!-- Outlined by default, filled on hover -->
        <Style x:Key="MatchCard.SelectButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource Icon.Check}" Width="14" Height="14" Stretch="Uniform"
                                      Fill="{TemplateBinding Foreground}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Light}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Light}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Dialog.CancelButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Secondary}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource Icon.ArrowLeft}" Width="14" Height="14" Stretch="Uniform"
                                      Fill="{TemplateBinding Foreground}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The dialog wrapper already shows the title; only the subtitle and divider are needed here. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="15" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,12">
                <Run Text="We found"/>
                <Run Text="{Binding Matches.Count, Mode=OneWay}" FontWeight="Bold"/>
                <Run Text="possible matches for your information. Please select the correct one."/>
            </TextBlock>
            <Rectangle Height="1" Fill="{DynamicResource Brush.Accent.Secondary}"/>
        </StackPanel>

        <!-- Original property -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Accent.Secondary}"
                BorderBrush="{DynamicResource Brush.Accent}"
                BorderThickness="1" Padding="16" CornerRadius="10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource Brush.Accent.Tertiary}" Padding="14,6" CornerRadius="8"
                        VerticalAlignment="Top" Margin="0,0,20,0">
                    <TextBlock Text="Original Property" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Light}"/>
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,8">
                        <Run Text="Parcel ID:"/>
                        <Run Text="{Binding OriginalParcelId, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Path Data="{StaticResource Icon.MapMarker}" Style="{StaticResource Match.Icon}" Margin="0,0,10,0"/>
                        <TextBlock Style="{StaticResource Match.Value}">
                            <Run Text="Address:"/>
                            <Run Text="{Binding OriginalAddress, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Person}" Style="{StaticResource Match.Icon}" Margin="0,0,10,0"/>
                        <TextBlock Style="{StaticResource Match.Value}">
                            <Run Text="Owner:"/>
                            <Run Text="{Binding OriginalOwner, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Matches -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Matches}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Border Background="{DynamicResource Brush.Background.Secondary}"
                                    BorderBrush="{DynamicResource Brush.Accent.Secondary}"
                                    BorderThickness="1" CornerRadius="10" Padding="24,16,16,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding ParcelId}" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Path Grid.Row="0" Data="{StaticResource Icon.MapMarker}" Style="{StaticResource Match.Icon}" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Address" Style="{StaticResource Match.Label}" Margin="0,3"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Address}" Style="{StaticResource Match.Value}" Margin="0,3"/>

                                            <Path Grid.Row="1" Data="{StaticResource Icon.City}" Style="{StaticResource Match.Icon}" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="City" Style="{StaticResource Match.Label}" Margin="0,3"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding City}" Style="{StaticResource Match.Value}" Margin="0,3"/>

                                            <Path Grid.Row="2" Data="{StaticResource Icon.Person}" Style="{StaticResource Match.Icon}" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Owner" Style="{StaticResource Match.Label}" Margin="0,3"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Owner, TargetNullValue=—}" Style="{StaticResource Match.Value}" Margin="0,3"/>
                                        </Grid>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Select as Correct"
                                            Style="{StaticResource MatchCard.SelectButton}"
                                            Command="{Binding DataContext.SelectMatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                            <!-- Accent stripe on the left edge -->
                            <Border Width="6" HorizontalAlignment="Left" CornerRadius="10,0,0,10"
                                    Background="{DynamicResource Brush.Accent}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Button Grid.Row="3" Content="Cancel" Style="{StaticResource Dialog.CancelButton}"
                Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
    </Grid>
</UserControl>
