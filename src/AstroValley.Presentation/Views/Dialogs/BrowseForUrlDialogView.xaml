<UserControl x:Class="AstroValley.Presentation.Views.Dialogs.BrowseForUrlDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="{StaticResource BrowserDialogWidth}" Height="{StaticResource BrowserDialogHeight}">
    <!-- A browser to find a page and return its URL (BrowseForUrlDialogViewModel). -->
    <DockPanel Margin="{StaticResource DialogPadding}">
        <!-- title bar: back, title, close -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogCloseButtonStyle}" Command="{Binding CancelCommand}">
                <materialDesign:PackIcon Kind="Close" />
            </Button>
            <!-- enabled from code-behind as the browser's history changes -->
            <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource DialogIconButtonStyle}" ToolTip="Back"
                    IsEnabled="False" Click="OnBackClick" Margin="0,0,8,0">
                <materialDesign:PackIcon Kind="ArrowLeft" />
            </Button>
            <TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- footer: what to do next, and the way out -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource TextButtonStyle}" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0" Command="{Binding SelectCommand}" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Check" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Select this page" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsAcceptable, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                <materialDesign:PackIcon Kind="InformationOutline" Style="{StaticResource InlineIconStyle}" />
                <TextBlock Text="{Binding Hint}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- the browser is created in code-behind, a fresh one for every dialog -->
        <Border x:Name="BrowserHost" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" />
    </DockPanel>
</UserControl>
