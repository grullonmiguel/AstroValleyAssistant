<UserControl x:Class="AstroValley.Presentation.Views.Dialogs.DueDiligenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="900">
    <!-- Due-diligence checklist for one pin (DueDiligenceViewModel): risk flags, names to search, legal description, checklist and website links by office.
         Colours, icons and button styles come from the theme; the styles below only size and arrange them for this dialog. -->
    <UserControl.Resources>
        <!-- text -->
        <Style x:Key="Text.Line" TargetType="TextBlock" BasedOn="{StaticResource Theme.TextBlock.Base}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Normal}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Tertiary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Text.Small" TargetType="TextBlock" BasedOn="{StaticResource Theme.TextBlock.Base}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- a hint under a checklist line; hidden when the line has none -->
        <Style x:Key="Text.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Width" Value="{StaticResource Size.Icon.Small}"/>
            <Setter Property="Height" Value="{StaticResource Size.Icon.Small}"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.Accent}"/>
        </Style>

        <!-- a section: white card with an icon (Tag = an Icon.* geometry), a bold title (Header) and the content -->
        <Style x:Key="Card" TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Border Background="{DynamicResource Brush.Background.Secondary}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,0,14,0"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="0,0,0,6"
                                                  TextElement.FontSize="{StaticResource FontSize.Normal}" TextElement.FontWeight="Bold"
                                                  TextElement.Foreground="{DynamicResource Brush.Accent.Tertiary}"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- small text action inside a card (Copy, Remove) -->
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource Theme.Button.IconOnly}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <!-- a record office's website, beside the office name -->
        <Style x:Key="OfficeLinkButton" TargetType="Button" BasedOn="{StaticResource Theme.Button.Outline}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Tag" Value="{StaticResource Icon.Web}"/>
            <Setter Property="ContentTemplate" Value="{StaticResource Theme.Button.Content.Icon}"/>
        </Style>
        <Style x:Key="IconButton.Outline" TargetType="Button" BasedOn="{StaticResource Theme.Button.Outline}">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="ContentTemplate" Value="{StaticResource Theme.Button.Content.Icon}"/>
        </Style>
        <!-- the primary style has no text size of its own; match the outline button beside it -->
        <Style x:Key="IconButton.Primary" TargetType="Button" BasedOn="{StaticResource Theme.Button.Primary}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Normal}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="ContentTemplate" Value="{StaticResource Theme.Button.Content.Icon}"/>
        </Style>

        <!-- the app's drop-down items have light text for its dark drop-downs; the status list opens on white -->
        <Style x:Key="StatusItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Tertiary}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Control.Primary.Foreground}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Control.Primary.Foreground}"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- one risk flag: tinted by how serious it is, with the theme's status colours -->
        <DataTemplate x:Key="RiskFlag">
            <Border x:Name="Flag" BorderThickness="4,0,0,0" CornerRadius="6" Padding="10,6" Margin="0,0,0,6"
                    Background="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Status.Info.Foreground}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Line}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="High">
                    <Setter TargetName="Flag" Property="Background" Value="{DynamicResource Brush.Status.Danger}"/>
                    <Setter TargetName="Flag" Property="BorderBrush" Value="{DynamicResource Brush.Status.Danger.Foreground}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Caution">
                    <Setter TargetName="Flag" Property="Background" Value="{DynamicResource Brush.Status.Warning}"/>
                    <Setter TargetName="Flag" Property="BorderBrush" Value="{DynamicResource Brush.Status.Warning.Foreground}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- a name to search, with its actions -->
        <DataTemplate x:Key="SearchName">
            <Border Background="{DynamicResource Brush.Background.Hover}" CornerRadius="12" Padding="10,2,4,2" Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Line}" FontSize="{StaticResource FontSize.Small}" VerticalAlignment="Center"/>
                    <Button Content="Copy" Style="{StaticResource LinkButton}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Remove" Style="{StaticResource LinkButton}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.RemoveNameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- an office card's title: the office name, then its websites (where the county is set up) -->
        <DataTemplate x:Key="OfficeHeader">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Office}" VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding Links}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" ToolTip="{Binding Hint}" Style="{StaticResource OfficeLinkButton}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- one checklist line: what to check, its status and a note -->
        <DataTemplate x:Key="ChecklistLine">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Line}"/>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Hint}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Small}" Padding="8,5"
                          ItemsSource="{Binding DataContext.Statuses, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding Status}" ItemContainerStyle="{StaticResource StatusItem}"
                          SelectionChanged="OnStatusChanged"/>
                <TextBox Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ToolTip="Note: book / page, amount, case number, who you spoke to..."/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- property and progress -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
            <DockPanel>
                <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Top">
                    <Ellipse Fill="{DynamicResource Brush.Accent}"/>
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.MapMarker}" Fill="{DynamicResource Brush.Accent.Foreground}"/>
                </Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Address}" Style="{StaticResource Text.Line}" FontSize="{StaticResource FontSize.Large}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
                    <ContentControl Content="{Binding Progress}" Style="{StaticResource Theme.Control.CountyInfoPill}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- where the answers are kept, and the way out -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,2,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Save Pins" Tag="{StaticResource Icon.Save}" Command="{Binding SavePinsCommand}" Style="{StaticResource IconButton.Outline}"
                            ToolTip="Save every pin on the map, with its checklist, to a file"/>
                    <Button Content="Done" Tag="{StaticResource Icon.Check}" Command="{Binding DoneCommand}" Style="{StaticResource IconButton.Primary}"/>
                </StackPanel>
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Info}" Margin="{StaticResource Margin.Icon.Right}"/>
                <TextBlock Text="Saved with the pin; use Save Pins to keep it on disk." Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <!-- risk flags found in the county record, most serious first -->
                <HeaderedContentControl Header="Risk flags" Tag="{StaticResource Icon.Alert}" Style="{StaticResource Card}"
                                        Visibility="{Binding HasRisks, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Risks}" ItemTemplate="{StaticResource RiskFlag}" Focusable="False"/>
                </HeaderedContentControl>

                <!-- names to search: owners from the county record plus anyone the user adds (trust, trustee, lender, case parties) -->
                <HeaderedContentControl Header="Names to search" Tag="{StaticResource Icon.Person}" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Small}" Margin="0,0,0,8"
                                   Text="Search each name in the recorder's official records and the court docket. A parcel-number search alone misses older documents. Add the trust, trustee, lenders and case parties you find."/>
                        <ItemsControl ItemsSource="{Binding Names}" ItemTemplate="{StaticResource SearchName}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="320" VerticalAlignment="Center"
                                     Tag="Add another name..." ToolTip="A name to add, e.g. the trust, its trustee, a lender">
                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddNameCommand}"/></TextBox.InputBindings>
                            </TextBox>
                            <Button Content="Add name" Tag="{StaticResource Icon.Plus}" Command="{Binding AddNameCommand}" Style="{StaticResource IconButton.Outline}" Padding="12,5"/>
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- the legal description: the best key for the recorder search (lots, block, plat book, OR book / page) -->
                <HeaderedContentControl Header="Legal description" Tag="{StaticResource Icon.Scale}" Style="{StaticResource Card}"
                                        Visibility="{Binding HasLegalDescription, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Copy" Tag="{StaticResource Icon.Copy}" ContentTemplate="{StaticResource Theme.Button.Content.Icon}"
                                Style="{StaticResource LinkButton}" VerticalAlignment="Top" Command="{Binding CopyCommand}" CommandParameter="{Binding LegalDescription}"/>
                        <TextBlock Text="{Binding LegalDescription}" Style="{StaticResource Text.Line}" FontSize="{StaticResource FontSize.Small}"/>
                    </DockPanel>
                </HeaderedContentControl>

                <!-- the checklist: one card per office -->
                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <HeaderedContentControl Header="{Binding}" HeaderTemplate="{StaticResource OfficeHeader}" Tag="{StaticResource Icon.Document}" Style="{StaticResource Card}">
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ChecklistLine}" Focusable="False"/>
                            </HeaderedContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
