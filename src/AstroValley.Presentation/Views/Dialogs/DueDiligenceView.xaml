<UserControl x:Class="AstroValley.Presentation.Views.Dialogs.DueDiligenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="840">
    <!-- Due-diligence checklist for one pin (DueDiligenceViewModel): risk flags, names to search, legal description, checklist by office -->
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- the app's item style has light text for dark drop-downs; these open on white -->
        <Style x:Key="StatusItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Foreground" Value="#30294B"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" FontSize="11" Foreground="{DynamicResource Brush.Accent}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="TextDecorations" Value="Underline"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- property and progress -->
        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="{Binding Address}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Small}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Progress}" FontSize="13" FontWeight="SemiBold" Foreground="#30294B" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <!-- risk flags found in the county record, most serious first -->
                <StackPanel Visibility="{Binding HasRisks, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Risk flags" Style="{StaticResource Section}"/>
                    <ItemsControl ItemsSource="{Binding Risks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Card" BorderThickness="4,0,0,0" BorderBrush="#2F80ED" Background="#F7F6FB" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#30294B"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="High"><Setter TargetName="Card" Property="BorderBrush" Value="#D64545"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Caution"><Setter TargetName="Card" Property="BorderBrush" Value="#CD7B2E"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- names to search: owners from the county record plus anyone the user adds (trust, trustee, lender, case parties) -->
                <TextBlock Text="Names to search" Style="{StaticResource Section}"/>
                <TextBlock Style="{StaticResource Small}" Margin="0,0,0,6"
                           Text="Search each name in the recorder's official records and the court docket. A parcel-number search alone misses older documents. Add the trust, trustee, lenders and case parties you find."/>
                <ItemsControl ItemsSource="{Binding Names}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#EEECF6" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#30294B" VerticalAlignment="Center"/>
                                    <Button Content="Copy" Style="{StaticResource LinkButton}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    <Button Content="Remove" Style="{StaticResource LinkButton}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.RemoveNameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="320" Padding="6,4" ToolTip="A name to add, e.g. the trust, its trustee, a lender">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddNameCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Add name" Command="{Binding AddNameCommand}" Style="{StaticResource Theme.Button.Outline}" Margin="8,0,0,0" Padding="12,4"/>
                </StackPanel>

                <!-- the legal description: the best key for the recorder search (lots, block, plat book, OR book / page) -->
                <StackPanel Visibility="{Binding HasLegalDescription, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Legal description" Style="{StaticResource Section}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LegalDescription}" FontSize="12" Foreground="#30294B" TextWrapping="Wrap" MaxWidth="700"/>
                        <Button Content="Copy" Style="{StaticResource LinkButton}" Command="{Binding CopyCommand}" CommandParameter="{Binding LegalDescription}"/>
                    </StackPanel>
                </StackPanel>

                <!-- the checklist, one group per office -->
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Office}" Style="{StaticResource Section}"/>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="270"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#30294B" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Hint}" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Small}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Hint}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                                                          ItemsSource="{Binding DataContext.Statuses, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding Status}" ItemContainerStyle="{StaticResource StatusItem}"
                                                          SelectionChanged="OnStatusChanged"/>
                                                <TextBox Grid.Column="2" Margin="8,0,0,0" Padding="6,3" VerticalAlignment="Center" FontSize="12"
                                                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ToolTip="Note: book / page, amount, case number, who you spoke to..."/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock Text="Saved with the pin; use Save Pins to keep it on disk." Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="Done" Command="{Binding DoneCommand}" Style="{StaticResource Theme.Button.Primary}" Padding="24,8"/>
        </StackPanel>
    </Grid>
</UserControl>
