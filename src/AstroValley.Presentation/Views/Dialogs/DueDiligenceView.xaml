<UserControl x:Class="AstroValley.Presentation.Views.Dialogs.DueDiligenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="900">
    <!-- Due-diligence checklist for one pin (DueDiligenceViewModel): risk flags, names to search, legal description, checklist and website links by office.
         Cards, text and buttons use the shared Theme.Dialog.* styles; only what is special to this dialog is styled here. -->
    <UserControl.Resources>
        <!-- a hint under a checklist line; hidden when the line has none -->
        <Style x:Key="Text.Hint" TargetType="TextBlock" BasedOn="{StaticResource Theme.Dialog.Text.Small}">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- a record office's website, beside the office name -->
        <Style x:Key="OfficeLinkButton" TargetType="Button" BasedOn="{StaticResource Theme.Button.Outline.Small}">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Tag" Value="{StaticResource Icon.Web}"/>
        </Style>

        <!-- one risk flag: tinted by how serious it is, with the theme's status colours -->
        <DataTemplate x:Key="RiskFlag">
            <Border x:Name="Flag" BorderThickness="4,0,0,0" CornerRadius="6" Padding="10,6" Margin="0,0,0,6"
                    Background="{DynamicResource Brush.Status.Info}" BorderBrush="{DynamicResource Brush.Status.Info.Foreground}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Theme.Dialog.Text}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Theme.Dialog.Text.Small}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="High">
                    <Setter TargetName="Flag" Property="Background" Value="{DynamicResource Brush.Status.Danger}"/>
                    <Setter TargetName="Flag" Property="BorderBrush" Value="{DynamicResource Brush.Status.Danger.Foreground}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Caution">
                    <Setter TargetName="Flag" Property="Background" Value="{DynamicResource Brush.Status.Warning}"/>
                    <Setter TargetName="Flag" Property="BorderBrush" Value="{DynamicResource Brush.Status.Warning.Foreground}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- a name to search, with its actions -->
        <DataTemplate x:Key="SearchName">
            <Border Background="{DynamicResource Brush.Background.Hover}" CornerRadius="12" Padding="10,2,4,2" Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" Style="{StaticResource Theme.Dialog.Text}" FontSize="{StaticResource FontSize.Small}" VerticalAlignment="Center"/>
                    <Button Content="Copy" Style="{StaticResource Theme.Dialog.Button.Link}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Remove" Style="{StaticResource Theme.Dialog.Button.Link}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.RemoveNameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- an office card's title: the office name, then its websites (where the county is set up) -->
        <DataTemplate x:Key="OfficeHeader">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Office}" VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding Links}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" ToolTip="{Binding Hint}" Style="{StaticResource OfficeLinkButton}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- one checklist line: what to check, its status and a note -->
        <DataTemplate x:Key="ChecklistLine">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Theme.Dialog.Text}"/>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Hint}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Theme.ComboBox.Light}"
                          ItemsSource="{Binding DataContext.Statuses, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding Status}"
                          SelectionChanged="OnStatusChanged"/>
                <TextBox Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ToolTip="Note: book / page, amount, case number, who you spoke to..."/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- property and progress -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Theme.Dialog.Header}">
            <DockPanel>
                <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Top">
                    <Ellipse Fill="{DynamicResource Brush.Accent}"/>
                    <Path Style="{StaticResource Theme.Dialog.Icon}" Data="{StaticResource Icon.MapMarker}" Fill="{DynamicResource Brush.Accent.Foreground}"/>
                </Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Address}" Style="{StaticResource Theme.Dialog.Text}" FontSize="{StaticResource FontSize.Large}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,2,0,0"/>
                    <ContentControl Content="{Binding Progress}" Style="{StaticResource Theme.Control.CountyInfoPill}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- where the answers are kept, and the way out -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Theme.Dialog.Footer}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Export Pins" Tag="{StaticResource Icon.Save}" Command="{Binding SavePinsCommand}" Style="{StaticResource Theme.Dialog.Button.Outline}"
                            ToolTip="Save a copy of every pin on the map, with its checklist, to a file you choose (for another computer or a backup)"/>
                    <Button Content="Done" Tag="{StaticResource Icon.Check}" Command="{Binding DoneCommand}" Style="{StaticResource Theme.Dialog.Button.Primary}"/>
                </StackPanel>
                <Path Style="{StaticResource Theme.Dialog.Icon}" Data="{StaticResource Icon.Info}" Margin="{StaticResource Margin.Icon.Right}"/>
                <TextBlock Text="Saved automatically with the pin." Style="{StaticResource Theme.Dialog.Text.Small}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <!-- risk flags found in the county record, most serious first -->
                <HeaderedContentControl Header="Risk flags" Tag="{StaticResource Icon.Alert}" Style="{StaticResource Theme.Dialog.Card}"
                                        Visibility="{Binding HasRisks, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Risks}" ItemTemplate="{StaticResource RiskFlag}" Focusable="False"/>
                </HeaderedContentControl>

                <!-- names to search: owners from the county record plus anyone the user adds (trust, trustee, lender, case parties) -->
                <HeaderedContentControl Header="Names to search" Tag="{StaticResource Icon.Person}" Style="{StaticResource Theme.Dialog.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,0,0,8"
                                   Text="Search each name in the recorder's official records and the court docket. A parcel-number search alone misses older documents. Add the trust, trustee, lenders and case parties you find."/>
                        <ItemsControl ItemsSource="{Binding Names}" ItemTemplate="{StaticResource SearchName}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="320" VerticalAlignment="Center"
                                     Tag="Add another name..." ToolTip="A name to add, e.g. the trust, its trustee, a lender">
                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddNameCommand}"/></TextBox.InputBindings>
                            </TextBox>
                            <Button Content="Add name" Tag="{StaticResource Icon.Plus}" Command="{Binding AddNameCommand}" Style="{StaticResource Theme.Dialog.Button.Outline}" Padding="12,5"/>
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- the legal description: the best key for the recorder search (lots, block, plat book, OR book / page) -->
                <HeaderedContentControl Header="Legal description" Tag="{StaticResource Icon.Scale}" Style="{StaticResource Theme.Dialog.Card}"
                                        Visibility="{Binding HasLegalDescription, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Copy" Tag="{StaticResource Icon.Copy}" ContentTemplate="{StaticResource Theme.Button.Content.Icon}"
                                Style="{StaticResource Theme.Dialog.Button.Link}" VerticalAlignment="Top" Command="{Binding CopyCommand}" CommandParameter="{Binding LegalDescription}"/>
                        <TextBlock Text="{Binding LegalDescription}" Style="{StaticResource Theme.Dialog.Text}" FontSize="{StaticResource FontSize.Small}"/>
                    </DockPanel>
                </HeaderedContentControl>

                <!-- the checklist: one card per office -->
                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <HeaderedContentControl Header="{Binding}" HeaderTemplate="{StaticResource OfficeHeader}" Tag="{StaticResource Icon.Document}" Style="{StaticResource Theme.Dialog.Card}">
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ChecklistLine}" Focusable="False"/>
                            </HeaderedContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
