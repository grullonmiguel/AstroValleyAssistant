<!-- src/AstroValley.Presentation/Views/Dialogs/WebNavigationView.xaml -->
<UserControl x:Class="AstroValley.Presentation.Views.Dialogs.WebNavigationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:vm="clr-namespace:AstroValley.Presentation.ViewModels.Dialogs"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:WebNavigationDialogViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" 
                    Margin="0,0,0,8"
                    VerticalAlignment="Top">
            <Button Content="← Back" 
                    Command="{Binding GoBackCommand}"
                    MinWidth="80"
                    Padding="12,6"/>
        </StackPanel>

        <!-- WebView2 Control -->
        <wv2:WebView2 x:Name="WebView"
                      Grid.Row="0"
                      Source="{Binding InitialUrl, Mode=OneTime}"
                      Margin="0,40,0,12"/>

        <!-- Button Panel -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,0,0,0">
            <Button Content="Select This URL" 
                    Command="{Binding SelectUrlCommand}"
                    MinWidth="120"
                    Padding="16,8"
                    Margin="0,0,8,0"/>
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}"
                    MinWidth="80"
                    Padding="16,8"/>
        </StackPanel>
    </Grid>
</UserControl>
