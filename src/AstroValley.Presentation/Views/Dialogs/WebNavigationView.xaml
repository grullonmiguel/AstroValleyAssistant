<!-- src/AstroValley.Presentation/Views/Dialogs/WebNavigationView.xaml -->
<UserControl x:Class="AstroValley.Presentation.Views.Dialogs.WebNavigationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:vm="clr-namespace:AstroValley.Presentation.ViewModels.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WebNavigationDialogViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Button Grid.Row="0" Content="← Back"
                Command="{Binding GoBackCommand}"
                Style="{StaticResource Theme.Button.Outline}"
                HorizontalAlignment="Left"
                Padding="16,6" FontSize="13"
                Margin="0,0,0,12"/>

        <!-- WebView2 Control -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Accent.Secondary}" BorderThickness="1" CornerRadius="4">
            <wv2:WebView2 x:Name="WebView"
                          Source="{Binding InitialUrl, Mode=OneTime}"/>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Hint shown until the browser is on a specific auction date page -->
            <Border Background="{DynamicResource Brush.Status.Warning}" CornerRadius="6" Padding="12,6"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Visibility="{Binding IsValidAuctionUrl, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                <TextBlock Foreground="{DynamicResource Brush.Status.Warning.Foreground}"
                           FontSize="12" FontWeight="SemiBold"
                           Text="Navigate to a specific auction date page to enable selection."/>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Theme.Button.Outline}"
                        Margin="0,0,12,0"/>
                <Button Content="Select This URL"
                        Command="{Binding SelectUrlCommand}"
                        Style="{StaticResource Theme.Button.Primary}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
