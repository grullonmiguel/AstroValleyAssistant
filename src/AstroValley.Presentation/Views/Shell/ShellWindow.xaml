<Window x:Class="AstroValley.Presentation.Views.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"        
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:AstroValley.Presentation.Controls"
        Title="{Binding AppName}"
        Width="1000"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">

    <!-- Removes the Windows title bar. The top CaptionHeight pixels become the drag area. Sizes come from Styles/Tokens/Sizes.xaml. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{StaticResource CaptionHeight}"
                            ResizeBorderThickness="{StaticResource WindowResizeBorderThickness}"
                            GlassFrameThickness="0,0,0,1"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>

        <!-- Everything below sits inside the DialogHost, so dialogs appear on top of the whole window. -->
        <materialDesign:DialogHost Identifier="RootDialog" DialogTheme="Inherit">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar: full height, slides open and closed (see SidebarStyle). -->
                <Border Grid.Column="0" Style="{StaticResource SidebarStyle}">
                    <DockPanel LastChildFill="True">
                        <!-- Keeps the sidebar content below the top strip. -->
                        <Border DockPanel.Dock="Top" Height="{StaticResource CaptionHeight}" />

                        <Button DockPanel.Dock="Top"
                                Command="{Binding ToggleSidebarCommand}"
                                Style="{StaticResource HamburgerButtonStyle}"
                                ToolTip="Toggle menu"
                                AutomationProperties.Name="Toggle menu" />

                        <!-- Logo placeholder: replace the icon with your logo image. -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,16">
                            <!--<materialDesign:PackIcon Kind="HexagonOutline"
                                                     Width="{StaticResource NavIconSize}"
                                                     Height="{StaticResource NavIconSize}"
                                                     Margin="17,0,0,0" />-->


                            <!-- Logo -->
                            <ContentControl Style="{StaticResource AppLogo}" Foreground="#FFF" Margin="4 0"/>
                            <TextBlock Text="{Binding AppName}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding SelectedNavigationItem}"
                                 ItemTemplate="{StaticResource NavItemTemplate}"
                                 Style="{StaticResource NavListBoxStyle}"
                                 Margin="0,8,0,0" />
                    </DockPanel>
                </Border>

                <!-- Content area -->
                <Grid Grid.Column="1">
                    <!-- Top strip: drag area. The caption buttons are drawn over it (see below). -->
                    <Border DockPanel.Dock="Top" Height="{StaticResource CaptionHeight}" />

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBarBorderStyle}">
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock Text="{Binding Version}" Style="{StaticResource StatusBarTextStyle}" Margin="0" />
                            </StackPanel>
                    </Border>

                    <Grid>
                        <controls:PageHost Page="{Binding CurrentPage}" />
                        <materialDesign:Snackbar MessageQueue="{Binding SnackbarMessageQueue}" Style="{StaticResource AppSnackbarStyle}"
                                                 VerticalAlignment="Bottom"
                                                 HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- Fade behind the caption buttons so they stay readable over the map; blends in on pages that show the window background. 56px clears the Home overlays (card at 60). -->
                    <!-- The window background (ThemeService swaps it per palette), faded out by the mask. -->
                    <!-- Only behind the caption buttons (4 x 46 = 184px wide): a radial mask from the top-right corner fades it left and down. -->
                    <!-- Hidden while trying primary-filled caption buttons instead (Window.xaml); set Visible to compare. -->
                    <Border Visibility="Collapsed" Width="370" Height="48" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                            Background="{DynamicResource AppBackgroundBrush}">
                        <Border.OpacityMask>
                            <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="1" RadiusY="1">
                                <GradientStop Offset="0" Color="Black" />
                                <GradientStop Offset="0.25" Color="Black" />
                                <GradientStop Offset="1" Color="Transparent" />
                            </RadialGradientBrush>
                        </Border.OpacityMask>
                    </Border>
                </Grid>
                
                <!--
                    THE BRAND BLOCK: the short colored bar at the top-left.
                    Its width is BrandBlockWidth in Styles/Tokens/Sizes.xaml. It sits above the sidebar and
                    content, so when the sidebar collapses the bar stays at full width.
                -->
                <controls:BrandBlock x:Name="BrandBlock"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     Text="{Binding AppName}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" />
            </Grid>
        </materialDesign:DialogHost>

        <!-- Caption buttons live above the DialogHost so they still work while a dialog is open. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource SettingsButtonStyle}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Settings" />
            <Button Style="{StaticResource MinimizeButtonStyle}" Click="OnMinimizeClick" />
            <Button Style="{StaticResource MaximizeButtonStyle}" Click="OnMaximizeRestoreClick" />
            <Button Style="{StaticResource CloseButtonStyle}" Click="OnCloseClick" />
        </StackPanel>

    </Grid>
</Window>
