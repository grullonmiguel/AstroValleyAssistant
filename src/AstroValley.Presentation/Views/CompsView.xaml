<UserControl x:Class="AstroValley.Presentation.Views.CompsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Site" TargetType="Button" BasedOn="{StaticResource Theme.Button.Outline}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="10" Padding="10,6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Hint" Text="0.00" Foreground="#9AA3B8" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Hint" Property="Foreground" Value="#C5CAD8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FilterSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8791A8"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Browser -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Content="← Back" Command="{Binding GoBackCommand}" Style="{StaticResource Site}" Margin="0,0,10,0"/>
                <!-- site switcher: light pill, the current site in dark purple -->
                <Border HorizontalAlignment="Left" Background="#DBD8E9" CornerRadius="18" Padding="4">
                    <ItemsControl ItemsSource="{Binding SiteOptions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.GoSiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Name}" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Pill" CornerRadius="14" Padding="16,6" Background="Transparent">
                                                <TextBlock x:Name="Text" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#534B80"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="#534B80"/>
                                                    <Setter TargetName="Text" Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </DockPanel>
            <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Accent.Secondary}" BorderThickness="1" CornerRadius="4">
                <wv2:WebView2 x:Name="WebView"/>
            </Border>
        </Grid>

        <!-- Sidebar -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <!-- the property being valued: typed in by hand, or filled when opened from a pin / grid row -->
                <Border Visibility="{Binding HasTarget, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#DBD8E9" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                    <TextBlock Text="{Binding TargetLabel, StringFormat='For: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#30294B" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Address" Style="{StaticResource Label}"/>
                    <TextBox Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"/>
                    <TextBlock Grid.Row="1" Text="Acres" Style="{StaticResource Label}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding AcresText, UpdateSourceTrigger=PropertyChanged}" Width="80" Style="{StaticResource Field}"/>
                        <TextBlock Text="Zip" Style="{StaticResource Label}" Margin="10,0,4,0"/>
                        <TextBox Text="{Binding ZipText, UpdateSourceTrigger=PropertyChanged}" Width="70" MaxLength="5" Style="{StaticResource Field}"/>
                        <CheckBox Content="House" ToolTip="Value by the median price of the comps instead of acres x $/acre" IsChecked="{Binding IsHome}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Analyze" Command="{Binding AnalyzeCommand}" Style="{StaticResource Theme.Button.Primary}" Padding="18,6" Margin="0,0,8,0"/>
                    <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource Theme.Button.Outline}" Padding="18,6" Margin="0,0,8,0"/>
                    <Button Content="New property" Command="{Binding NewPropertyCommand}" Style="{StaticResource Theme.Button.Outline}" Padding="12,6"/>
                </StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <!-- Filters: collapsible card; the lists filter as you type -->
                <Border Background="White" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.12" Color="#30294B"/></Border.Effect>
                    <StackPanel>
                        <ToggleButton x:Name="FiltersToggle" IsChecked="True" Cursor="Hand" HorizontalAlignment="Left">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#F3F0FC">
                                            <Path Data="M4,7 H20 M7,12 H17 M10,17 H14" Stroke="#5B4BA6" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None"/>
                                        </Border>
                                        <TextBlock Text="Filters" FontSize="18" FontWeight="SemiBold" Foreground="#171528" VerticalAlignment="Center" Margin="14,0,16,0"/>
                                        <Path x:Name="Chevron" Data="M1,1 L7,7 L13,1" Stroke="#8791A8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform><RotateTransform x:Name="ChevronTurn" Angle="0"/></Path.RenderTransform>
                                        </Path>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="-90" Duration="0:0:0.2"/></Storyboard></BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- body: squashes to nothing when collapsed -->
                        <Border ClipToBounds="True" Margin="0,8,0,0">
                                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleY="1"/></Setter.Value></Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=FiltersToggle}" Value="False">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard><Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(Border.LayoutTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.22"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                                </Storyboard></BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard><Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(Border.LayoutTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                                                </Storyboard></BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Acres" Style="{StaticResource FilterHead}"/>
                                <TextBlock Text="Min" Style="{StaticResource FilterSub}"/>
                                <TextBox Text="{Binding MinAcres, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                                <TextBlock Text="Max" Style="{StaticResource FilterSub}"/>
                                <TextBox Text="{Binding MaxAcres, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                <TextBlock Text="Price" Style="{StaticResource FilterHead}"/>
                                <TextBlock Text="Min" Style="{StaticResource FilterSub}"/>
                                <TextBox Text="{Binding MinPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                                <TextBlock Text="Max" Style="{StaticResource FilterSub}"/>
                                <TextBox Text="{Binding MaxPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="$/Acre" Style="{StaticResource FilterHead}"/>
                                <TextBlock Text="Min" Style="{StaticResource FilterSub}"/>
                                <TextBox Text="{Binding MinPpa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                                <TextBlock Text="Max" Style="{StaticResource FilterSub}"/>
                                <TextBox Text="{Binding MaxPpa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                            </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                    <TextBlock Text="Sort by:" Style="{StaticResource Label}" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" MinWidth="170" FontSize="12"/>
                </StackPanel>

                <!-- stats -->
                <Border Background="#F4F2FB" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Count, StringFormat='{}{0} comps'}" FontSize="11" Style="{StaticResource Label}"/>
                        <TextBlock Grid.Column="1" Text="Acres" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="Price" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="$/Acre" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Row="1" Text="Avg" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AvgAcres, StringFormat={}{0:0.00}}" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AvgPrice, StringFormat={}{0:C0}}" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding AvgPpa, StringFormat={}{0:C0}}" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Text="Median" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MedianAcres, StringFormat={}{0:0.00}}" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MedianPrice, StringFormat={}{0:C0}}" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding MedianPpa, StringFormat={}{0:C0}}" FontSize="12" Margin="0,4,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- comps -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Visible}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#E2DFEE" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Lot Size -->
                                            <TextBlock Text="{Binding LotText}" FontSize="15" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
                                            
                                            <!-- SOLD -->
                                            <Border Background="#E3F0FB" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold" Foreground="#2F6DA3"/>
                                            </Border>
                                        </StackPanel>
                                        
                                        <TextBlock Text="{Binding LotDetail}" FontSize="11" Foreground="#555555" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding PriceMiles}" FontSize="11" Foreground="#555555" Margin="0,2,0,0"/>
                                        
                                        <TextBlock Text="{Binding HomeText}" FontSize="11" Foreground="#555555" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HomeText}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- the address opens the listing in the default browser; a button looks like a link and, unlike a Hyperlink, its command binding works here -->
                                        <Button Margin="0,4,0,0" HorizontalAlignment="Left" Cursor="Hand" ToolTip="Open in your browser" Click="OnListingClick">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent"><!-- a background so the whole text area catches the mouse -->
                                                        <TextBlock x:Name="Link" Text="{Binding Address}" FontSize="12" Foreground="#4F4486" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Link" Property="TextDecorations" Value="Underline"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource Theme.Button.IconOnly}" FontSize="11" Padding="4,0"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:C0}'}" FontSize="17" FontWeight="Bold" Foreground="#8E7CC3" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- market value + actions -->
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <Border Background="#DBD8E9" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Market value" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding EstimateText}" FontSize="22" FontWeight="Bold" Foreground="#30294B"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="$ / acre" Style="{StaticResource Label}" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding PpaText, UpdateSourceTrigger=PropertyChanged}" Width="90" Style="{StaticResource Field}"/>
                            <CheckBox Content="Median" IsChecked="{Binding UseMedian}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Land: acres × $/acre. Home: the median price of the comps."/>
                    </StackPanel>
                </Border>
                <Button Content="Export HTML map" Command="{Binding ExportHtmlCommand}" Style="{StaticResource Theme.Button.Outline}" HorizontalAlignment="Right" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding HasTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="Back" Command="{Binding BackWithoutSavingCommand}" Style="{StaticResource Theme.Button.Outline}" Margin="0,0,12,0"/>
                    <Button Content="Send value back" Command="{Binding UseCompsCommand}" Style="{StaticResource Theme.Button.Primary}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
