<UserControl x:Class="AstroValley.Presentation.Views.CompsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstroValley.Presentation.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Site" TargetType="Button" BasedOn="{StaticResource Theme.Button.Outline}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- hyperlink-looking button with an icon: Content = text, Tag = the icon's StreamGeometry; underlines on hover -->
        <Style x:Key="IconLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#534B80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4,2">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock x:Name="Text" Text="{TemplateBinding Content}" FontSize="13" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Text" Property="TextDecorations" Value="Underline"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- same look as the site switcher: Pill = a site that is not selected, PillOn = the selected one -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="14" Padding="16,6" Background="Transparent">
                            <TextBlock x:Name="Text" Text="{TemplateBinding Content}" FontSize="13" FontWeight="SemiBold" Foreground="#534B80"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#CFCBE2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Text" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillOn" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="14" Padding="16,6" Background="#534B80">
                            <TextBlock x:Name="Text" Text="{TemplateBinding Content}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#665C9E"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Pill" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="10" Padding="10,6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Hint" Text="0.00" Foreground="#9AA3B8" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Hint" Property="Foreground" Value="#C5CAD8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FilterSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8791A8"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Browser -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- map mode: the same row holds the map's buttons instead -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMapVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- same pill group as Clear / New property / Analyze -->
                <Border Background="#DBD8E9" CornerRadius="18" Padding="4" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="← Back to browser" Padding="18,6" Margin="2,0,2,0" Style="{StaticResource PillOn}" Command="{Binding BackToBrowserCommand}"/>
                        <Button Content="Export HTML" Padding="18,6" Margin="2,0,2,0" Style="{StaticResource Pill}" Command="{Binding ExportHtmlCommand}"/>
                    </StackPanel>
                </Border>
                <!-- WPF can't draw over a WebView2, so loading progress sits in this bar -->
                <ProgressBar IsIndeterminate="True" Width="90" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"
                             Visibility="{Binding IsMapLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding MapStatus}" VerticalAlignment="Center" Style="{StaticResource Label}"/>
            </StackPanel>
            <DockPanel Margin="0,0,0,8">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMapVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <Button DockPanel.Dock="Left" Content="← Back" Command="{Binding GoBackCommand}" Style="{StaticResource Site}" Margin="0,0,10,0"/>
                <!-- site switcher: light pill, the current site in dark purple -->
                <Border HorizontalAlignment="Left" Background="#DBD8E9" CornerRadius="18" Padding="4">
                    <ItemsControl ItemsSource="{Binding SiteOptions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.GoSiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Name}" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Pill" CornerRadius="14" Padding="16,6" Background="Transparent">
                                                <TextBlock x:Name="Text" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#534B80"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="#534B80"/>
                                                    <Setter TargetName="Text" Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </DockPanel>
            <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Accent.Secondary}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <!-- Hidden (not Collapsed) keeps the page, login and history alive behind the map -->
                    <wv2:WebView2 x:Name="WebView">
                        <wv2:WebView2.Style>
                            <Style TargetType="wv2:WebView2">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMapVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HideBrowser}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </wv2:WebView2.Style>
                    </wv2:WebView2>
                    <!-- in the browser's place while it visits the property's own page (WPF cannot draw over a visible WebView2) -->
                    <Grid Background="#F4F3F9" Visibility="{Binding HideBrowser, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <local:ScrapeOverlay/>
                    </Grid>
                    <wv2:WebView2 x:Name="MapWebView">
                        <wv2:WebView2.Style>
                            <Style TargetType="wv2:WebView2">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMapVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </wv2:WebView2.Style>
                    </wv2:WebView2>
                </Grid>
            </Border>
        </Grid>

        <!-- Sidebar -->
        <Grid Grid.Column="1" Margin="12,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                
                <!-- the property being valued: typed in by hand, or filled when opened from a pin / grid row -->
                <Border CornerRadius="6"
                        Padding="10,6" 
                        Margin="0,0,0,8"
                        Background="#DBD8E9" 
                        Visibility="{Binding HasTarget, Converter={StaticResource BooleanToVisibilityConverter}}" >
                    <TextBlock FontSize="12"                                
                               FontWeight="SemiBold"
                               Foreground="#30294B" 
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding TargetLabel, StringFormat='For: {0}'}" />
                </Border>
                
                <!-- Action Buttons -->
                <Border Background="#DBD8E9" CornerRadius="18" Padding="4" Margin="0,0,0,8">
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <!-- Clear Button -->
                        <Button Content="Clear" 
                                Padding="18,6" 
                                Margin="2,0,2,0"
                                Style="{StaticResource Pill}"
                                Command="{Binding ClearCommand}"/>
                        <!-- New Property Button -->
                        <Button Grid.Column="1" 
                                Padding="12,6"
                                Margin="2,0,2,0"
                                Content="New property" 
                                Style="{StaticResource Pill}"
                                Command="{Binding NewPropertyCommand}" />
                        <!-- Analyze Button -->
                        <Button Grid.Column="2" 
                                Content="Analyze" 
                                Padding="18,6" 
                                Margin="2,0,2,0"
                                Style="{StaticResource PillOn}"
                                Command="{Binding AnalyzeCommand}" />
                    </Grid>
                </Border>

                <!-- Property Address -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <!-- Address -->
                    <TextBlock Text="Address" Style="{StaticResource Label}"/>
                    <TextBox Grid.Column="1" 
                             Style="{StaticResource Field}"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Acres / Zip Code / Is House or Lot -->
                    <TextBlock Grid.Row="1" Text="Acres" Style="{StaticResource Label}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding AcresText, UpdateSourceTrigger=PropertyChanged}" Width="80" Style="{StaticResource Field}"/>
                        <TextBlock Text="Zip" Style="{StaticResource Label}" Margin="10,0,4,0"/>
                        <TextBox Text="{Binding ZipText, UpdateSourceTrigger=PropertyChanged}" Width="70" MaxLength="5" Style="{StaticResource Field}"/>
                        <CheckBox Content="House" ToolTip="Value the house: $/sqft x its sqft (or the median price without a sqft), comparing home size, beds and baths instead of the lot" IsChecked="{Binding IsHome}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <!-- the house, from the property appraiser; blank boxes are simply not compared -->
                    <TextBlock Grid.Row="2" Text="Sqft" Style="{StaticResource Label}"
                               Visibility="{Binding IsHome, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- wraps: Mobile home / Duplex / multi drop to a second line when the panel is narrow -->
                    <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                                Visibility="{Binding IsHome, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox Text="{Binding HomeSqftText, UpdateSourceTrigger=PropertyChanged}" Width="80" Style="{StaticResource Field}" ToolTip="The house's living area in square feet (property appraiser)"/>
                        <TextBlock Text="Beds" Style="{StaticResource Label}" Margin="10,0,4,0"/>
                        <TextBox Text="{Binding BedsText, UpdateSourceTrigger=PropertyChanged}" Width="34" Style="{StaticResource Field}"/>
                        <TextBlock Text="Baths" Style="{StaticResource Label}" Margin="8,0,4,0"/>
                        <TextBox Text="{Binding BathsText, UpdateSourceTrigger=PropertyChanged}" Width="34" Style="{StaticResource Field}"/>
                        <CheckBox Content="Mobile home" IsChecked="{Binding IsMobile}" VerticalAlignment="Center" Margin="10,4,0,4"
                                  ToolTip="Mobile and manufactured homes sell in a different market: comps of the other kind are flagged as outliers"/>
                        <CheckBox Content="Duplex / multi" IsChecked="{Binding IsMultiFamily}" VerticalAlignment="Center" Margin="10,4,0,4"
                                  ToolTip="A duplex or other 2-4 unit building (appraiser land use 'Multifamily'): Zillow is searched for multi-family sales, and single-family comps are flagged as outliers. Use the building's total sqft, beds and baths."/>
                    </WrapPanel>
                </Grid>
                
                <!-- Status -->
                <TextBlock Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           Text="{Binding Message}" 
                           Style="{StaticResource Label}" />

                <!-- Filters -->
                <Border Background="White" CornerRadius="12" Padding="12 8" Margin="0,0,0,8" >
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.12" Color="#30294B"/>
                    </Border.Effect>
                    <StackPanel>
                        <ToggleButton x:Name="FiltersToggle" IsChecked="True" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28" CornerRadius="8" Background="#F3F0FC">
                                                <Path Stretch="None"
                                                  Stroke="#5B4BA6" 
                                                  StrokeThickness="2" 
                                                  StrokeStartLineCap="Round" 
                                                  StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center" 
                                                  Data="M4,7 H20 M7,12 H17 M10,17 H14" />
                                            </Border>
                                            <TextBlock Text="Filters" 
                                                       FontSize="14" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="#171528" 
                                                       VerticalAlignment="Center"
                                                       Margin="14,0,16,0"/>
                                        </StackPanel>
                                        <!-- Comps Total -->
                                        <TextBlock Grid.Column="1"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#8A7FCB"
                                                   VerticalAlignment="Center">
                                            <Run Text="("/><Run Text="{Binding Count, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=")"/>
                                        </TextBlock>
                                        <Path Grid.Column="2" 
                                              x:Name="Chevron" 
                                              Data="M1,1 L7,7 L13,1" 
                                              Stroke="#8791A8" 
                                              StrokeThickness="2" 
                                              StrokeStartLineCap="Round" 
                                              StrokeEndLineCap="Round"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="ChevronTurn" Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="-90" Duration="0:0:0.2"/></Storyboard></BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- body: squashes to nothing when collapsed -->
                        <Border ClipToBounds="True" Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleY="1"/></Setter.Value></Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=FiltersToggle}" Value="False">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard><Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(Border.LayoutTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.22"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                                </Storyboard></BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard><Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(Border.LayoutTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                                                </Storyboard></BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Acres" Style="{StaticResource FilterHead}"/>
                                <!-- Min / Max look like the other labels; clicking one fills a size band around the property's lot -->
                                <TextBlock Text="Min" Style="{StaticResource FilterSub}" Cursor="Hand" ToolTip="{Binding MinAcresTip}">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding FillAcresCommand}" CommandParameter="Min"/>
                                    </TextBlock.InputBindings>
                                </TextBlock>
                                <TextBox Text="{Binding MinAcres, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                                <TextBlock Text="Max" Style="{StaticResource FilterSub}" Cursor="Hand" ToolTip="{Binding MaxAcresTip}">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding FillAcresCommand}" CommandParameter="Max"/>
                                    </TextBlock.InputBindings>
                                </TextBlock>
                                <TextBox Text="{Binding MaxAcres, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                <TextBlock Text="Price" Style="{StaticResource FilterHead}"/>
                                <TextBlock Text="Min" Style="{StaticResource FilterSub}"/>
                                <TextBox Text="{Binding MinPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                                <TextBlock Text="Max" Style="{StaticResource FilterSub}"/>
                                <TextBox Text="{Binding MaxPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="$/Acre" Style="{StaticResource FilterHead}"/>
                                <TextBlock Text="Min" Style="{StaticResource FilterSub}"/>
                                <TextBox Text="{Binding MinPpa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                                <TextBlock Text="Max" Style="{StaticResource FilterSub}"/>
                                <TextBox Text="{Binding MaxPpa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                            </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Comps -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border Background="White" CornerRadius="12" Padding="12 8"
                        Visibility="{Binding HasComps, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.12" Color="#30294B"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- -->
                        <StackPanel>

                            <!-- Stats -->
                            <Border  Padding="12,8" Margin="0,0,0,12" Background="#DBD8E9" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Column="1" Text="{Binding SizeHead}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="Price" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="{Binding RateHead}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Row="2" Text="Avg" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                                    <Border Grid.Row="1" Grid.ColumnSpan="34" Background="#C0C0C0" Height="1" Margin="0 4 0 3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AvgSizeText}" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding AvgPrice, StringFormat={}{0:C0}}" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding AvgPpa, StringFormat={}{0:C0}}" FontSize="12" Margin="0,4,0,0"/>

                                    <Border Grid.Row="3" Grid.ColumnSpan="34" Background="#C0C0C0" Height="1" Margin="0 4 0 3" />
                                    <TextBlock Grid.Row="4" Text="Median" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MedianSizeText}" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding MedianPrice, StringFormat={}{0:C0}}" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding MedianPpa, StringFormat={}{0:C0}}" FontSize="12" Margin="0,4,0,0"/>
                                </Grid>
                            </Border>

                            <!-- View on Map | Sort By-->
                            <Grid Margin="0 0 0 12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- View on Map -->
                                <Button Content="View on Map" 
                                        Style="{StaticResource IconLink}" 
                                        Tag="{StaticResource Icon.MapPin}"
                                        Command="{Binding ReviewOnMapCommand}"                            
                                        Visibility="{Binding HasComps, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <!-- Sort By -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" >
                                    <TextBlock Text="Sort:" Style="{StaticResource Label}" Margin="0,0,6,0"/>
                                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" MinWidth="150" FontSize="12">
                                        <!-- the app's item style has light text for dark drop-downs; this one opens on white, so dark text, light on hover / selected -->
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                <Setter Property="Foreground" Value="#30294B"/>
                                                <Setter Property="Padding" Value="10,6"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
                                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                        </StackPanel>

                        <!-- Property List -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Visible}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" 
                                            BorderBrush="#E2DFEE" 
                                            BorderThickness="1" 
                                            CornerRadius="10" 
                                            Padding="14,10" Margin="0,0,0,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <!-- an outlier left out of the value -->
                                                    <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                        <Setter Property="Opacity" Value="0.6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.12" Color="#30294B"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <WrapPanel> <!-- heading and badges wrap instead of cutting off "SOLD OCT 15, 2026" -->
                                                    <!-- Lot Size -->
                                                    <TextBlock Text="{Binding Headline}" FontSize="15" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>

                                                    <!-- SOLD -->
                                                    <Border Background="#E3F0FB" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold" Foreground="#2F6DA3"/>
                                                    </Border>

                                                    <!-- VERIFY: no link / no address / guessed address; the tooltip says which -->
                                                    <Border Background="#FDEFD9" CornerRadius="6" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{Binding Verify}">
                                                        <TextBlock Text="VERIFY" FontSize="10" FontWeight="SemiBold" Foreground="#A35A12"/>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Verify}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <!-- OUTLIER: a misleading sale (house on a land comp, token price, far from the median) -->
                                                    <Border Background="#FBE3E3" CornerRadius="6" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{Binding OutlierTip}">
                                                        <TextBlock Text="OUTLIER" FontSize="10" FontWeight="SemiBold" Foreground="#B23A3A"/>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Outlier}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </WrapPanel>

                                                <TextBlock Text="{Binding SubLine}" 
                                                   FontSize="11" 
                                                   Foreground="#555555" 
                                                   Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding HomeText}" TextWrapping="Wrap" 
                                                   FontSize="11" 
                                                   Foreground="#555555" 
                                                   Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HomeText}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding PriceMiles}" 
                                                   FontSize="11" 
                                                   Foreground="#555555" 
                                                   Margin="0,2,0,0"/>

                                                <!-- how much this comp counts; the tooltip says why -->
                                                <TextBlock FontSize="11" Foreground="#555555" Margin="0,2,0,0" TextWrapping="Wrap" ToolTip="{Binding WeightTip}">
                                                    <Run Text="Weight"/>
                                                    <Run Text="{Binding WeightDots, Mode=OneWay}" Foreground="#534B80" FontSize="12"/>
                                                    <Run Text="{Binding WeightWhy, Mode=OneWay}"/>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Outlier}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding Outlier}" ToolTip="{Binding OutlierTip}" FontSize="11" Foreground="#B23A3A" TextWrapping="Wrap" MaxWidth="230" VerticalAlignment="Center"/>
                                                    <!-- only while it is left out; the X removes it again -->
                                                    <Button Content="Include anyway" Margin="8,0,0,0" FontSize="11" Padding="6,1" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.IncludeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding IsExcluded, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                                <!-- the address opens the listing in the default browser; a button looks like a link and, unlike a Hyperlink, its command binding works here -->
                                                <Button Margin="0,4,0,0" HorizontalAlignment="Left" Cursor="Hand" ToolTip="Open in your browser" Click="OnListingClick">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <!-- a background so the whole text area catches the mouse -->
                                                                <TextBlock x:Name="Link" Text="{Binding Address}" FontSize="12" Foreground="#4F4486" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Link" Property="TextDecorations" Value="Underline"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource Theme.Button.IconOnly}" FontSize="11" Padding="4,0"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding Price, StringFormat='{}{0:C0}'}" FontSize="17" FontWeight="Bold" Foreground="#8E7CC3" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </ScrollViewer>
            <!-- Analyze progress over the comps list (the shared busy overlay) -->
            <Grid Grid.Row="1" Visibility="{Binding ShowListOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <local:ScrapeOverlay/>
            </Grid>

            <!-- Market value -->
            <StackPanel Grid.Row="2" Margin="-8,0,0,0">
                <Border Background="#DBD8E9" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Market value" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding EstimateText}" FontSize="22" FontWeight="Bold" Foreground="#30294B"/>
                        <TextBlock Text="{Binding RangeText}" Style="{StaticResource Label}"/>
                        <!-- how far to trust the value: High (3+ strong comps) / Medium / Low, and why -->
                        <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap">
                            <Run FontWeight="Bold" Text="{Binding ConfidenceLevel, Mode=OneWay}">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Foreground" Value="#B23A3A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="High"><Setter Property="Foreground" Value="#2E9E5B"/></DataTrigger>
                                            <DataTrigger Binding="{Binding ConfidenceLevel}" Value="Medium"><Setter Property="Foreground" Value="#CD7B2E"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                            <Run Text="{Binding ConfidenceText, Mode=OneWay}" Foreground="#555555"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding RateLabel}" Style="{StaticResource Label}" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding PpaText, UpdateSourceTrigger=PropertyChanged}" Width="90" Style="{StaticResource Field}"/>
                            <CheckBox Content="Median" IsChecked="{Binding UseMedian}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" 
                                   Margin="0,4,0,0"
                                   Style="{StaticResource Label}" 
                                   Text="{Binding ValueHow}"/>
                    </StackPanel>
                </Border>
                
                <Grid Visibility="{Binding HasTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Margin="0,0,8,8"
                            Content="Clear Removed" 
                            Command="{Binding ShowRemovedCommand}" 
                            Style="{StaticResource Theme.Button.Outline}" 
                            Visibility="{Binding HasRemoved, Converter={StaticResource BooleanToVisibilityConverter}}"/>  
                    <Button Grid.Column="1" 
                            Content="Return" 
                            Command="{Binding BackWithoutSavingCommand}" 
                            Style="{StaticResource Theme.Button.Outline}" 
                            Margin="0,0,12,8"/>
                    <Button Grid.Column="2" 
                            Content="Apply Value" 
                            Command="{Binding UseCompsCommand}" 
                            Style="{StaticResource Theme.Button.Primary}" 
                            Margin="0 0 0 8"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
