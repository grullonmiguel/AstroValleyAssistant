<UserControl x:Class="AstroValley.Presentation.Views.CompsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstroValley.Presentation.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <!-- Buttons, text boxes, the drop-down, icons and every colour come from the theme; the styles here only size and arrange
             them for this view. -->
        <!-- right margin of the parts that do not scroll: the room the scroll bar and the list's gap take, so every card lines up -->
        <Thickness x:Key="ScrollGutter">0,0,24,0</Thickness>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- a card's title, and the quieter lines under it -->
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Normal}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Tertiary}"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <!-- the app's text box, a little tighter: the Beds / Baths boxes are narrow -->
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource Theme.TextBox}">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>
        <!-- a filter box: the app's text box with "0.00" as its helper text while empty -->
        <Style x:Key="FilterBox" TargetType="TextBox" BasedOn="{StaticResource Theme.TextBox}">
            <Setter Property="Tag" Value="0.00"/>
        </Style>
        <Style x:Key="FilterHead" TargetType="TextBlock" BasedOn="{StaticResource Sub}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Normal}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FilterSub" TargetType="TextBlock" BasedOn="{StaticResource Sub}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
        </Style>
        <!-- the 2 x 2 figures in the value card -->
        <Style x:Key="Stat" TargetType="StackPanel">
            <Setter Property="Margin" Value="6,6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Title}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Secondary.Hover}"/>
        </Style>
        <!-- small "i" that explains something on hover -->
        <Style x:Key="InfoIcon" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource Icon.Info}"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- icon beside a title or a line of text -->
        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- a text link with an icon (Open on Zillow, Restore removed): the dialogs' link button -->
        <Style x:Key="IconLink" TargetType="Button" BasedOn="{StaticResource Theme.Dialog.Button.Link}">
            <Setter Property="ContentTemplate" Value="{StaticResource Theme.Button.Content.Icon}"/>
            <Setter Property="Margin" Value="-6,2,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- a site in the switcher: a pill, filled while it is the current site -->
        <Style x:Key="SitePill" TargetType="Button" BasedOn="{StaticResource Theme.Button.Pill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Light}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- white card with a soft shadow -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10" Color="{StaticResource Color.Tertiary}"/></Setter.Value>
            </Setter>
        </Style>
        <!-- where a photo goes: a tinted tile with a house icon, which the photo covers when there is one -->
        <Style x:Key="PhotoTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/>
        </Style>
        <Style x:Key="PhotoTile.Icon" TargetType="Path" BasedOn="{StaticResource Glyph}">
            <Setter Property="Data" Value="{StaticResource Icon.Home}"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Secondary}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <!-- small rounded tag (match quality, VERIFY, OUTLIER, confidence), in the theme's status colours; text and icon inside follow it -->
        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,2,4,0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="TextElement.FontSize" Value="10"/>
            <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Tag.Warning" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Setter Property="Background" Value="{DynamicResource Brush.Status.Warning}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Status.Warning.Foreground}"/>
        </Style>
        <Style x:Key="Tag.Danger" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Setter Property="Background" Value="{DynamicResource Brush.Status.Danger}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Status.Danger.Foreground}"/>
        </Style>
        <Style x:Key="Tag.Icon" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource Icon.Check}"/>
            <Setter Property="Fill" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <!-- Browser -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- map mode: the same row holds the map's buttons instead -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMapVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- same pill group as Clear / New property / Analyze -->
                <Border Style="{StaticResource Theme.Border.PillGroup}" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Back to browser" Tag="{StaticResource Icon.ArrowLeft}" Style="{StaticResource Theme.Button.Pill.On}" Command="{Binding BackToBrowserCommand}"/>
                        <Button Content="Export HTML" Tag="{StaticResource Icon.Html}" Style="{StaticResource Theme.Button.Pill}" Command="{Binding ExportHtmlCommand}"/>
                    </StackPanel>
                </Border>
                <!-- WPF can't draw over a WebView2, so loading progress sits in this bar -->
                <ProgressBar IsIndeterminate="True" Width="90" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"
                             Visibility="{Binding IsMapLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding MapStatus}" VerticalAlignment="Center" Style="{StaticResource Label}"/>
            </StackPanel>
            <DockPanel Margin="0,0,0,8">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMapVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <Button DockPanel.Dock="Left" Content="Back" Tag="{StaticResource Icon.ArrowLeft}" Command="{Binding GoBackCommand}" Style="{StaticResource Theme.Button.Outline.Small}" Margin="0,0,10,0"/>
                <!-- site switcher: light pill, the current site in dark purple -->
                <Border HorizontalAlignment="Left" Style="{StaticResource Theme.Border.PillGroup}">
                    <ItemsControl ItemsSource="{Binding SiteOptions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" 
                                        Style="{StaticResource SitePill}" 
                                        CommandParameter="{Binding Name}"
                                        Command="{Binding DataContext.GoSiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </DockPanel>
            <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Accent.Secondary}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <!-- Hidden (not Collapsed) keeps the page, login and history alive behind the map -->
                    <wv2:WebView2 x:Name="WebView">
                        <wv2:WebView2.Style>
                            <Style TargetType="wv2:WebView2">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMapVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HideBrowser}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </wv2:WebView2.Style>
                    </wv2:WebView2>
                    <!-- in the browser's place while it visits the property's own page (WPF cannot draw over a visible WebView2) -->
                    <Grid Background="{DynamicResource Brush.Background.Primary}" Visibility="{Binding HideBrowser, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <local:ScrapeOverlay/>
                    </Grid>
                    <wv2:WebView2 x:Name="MapWebView">
                        <wv2:WebView2.Style>
                            <Style TargetType="wv2:WebView2">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMapVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </wv2:WebView2.Style>
                    </wv2:WebView2>
                </Grid>
            </Border>
        </Grid>

        <!-- Sidebar -->
        <Grid Grid.Column="1" Margin="12,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="{StaticResource ScrollGutter}">
                <!-- actions: one strip, the main one filled -->
                <Border Style="{StaticResource Theme.Border.PillGroup}" Margin="0,0,0,10">
                    <UniformGrid Columns="3">
                        <Button Content="Clear" Padding="8,6" Tag="{StaticResource Icon.Refresh}" Style="{StaticResource Theme.Button.Pill}" Command="{Binding ClearCommand}"/>
                        <Button Content="New Property" Padding="8,6" Tag="{StaticResource Icon.PlusBox}" Style="{StaticResource Theme.Button.Pill}" Command="{Binding NewPropertyCommand}"/>
                        <Button Content="Analyze" Padding="8,6" Tag="{StaticResource Icon.Magnify}" Style="{StaticResource Theme.Button.Pill.On}" Command="{Binding AnalyzeCommand}"/>
                    </UniformGrid>
                </Border>

                <!-- the property being valued: a summary; Edit shows the boxes (open by default for a typed-in property) -->
                <Border Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="64" Height="64" VerticalAlignment="Top">
                                <Border Style="{StaticResource PhotoTile}">
                                    <Path Style="{StaticResource PhotoTile.Icon}"/>
                                </Border>
                                <!-- the property's photo from the current site, when it has one (covers the icon) -->
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding SubjectPhoto, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                <TextBlock Text="{Binding SubjectTitle}" Style="{StaticResource Title}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SubjectLine2}" Style="{StaticResource Sub}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SubjectLine3}" Style="{StaticResource Sub}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <!-- its listing on the site of the last Analyze (each site's link is kept; this swaps with the site) -->
                                <Button Content="{Binding SubjectLinkText}" Style="{StaticResource IconLink}" Tag="{StaticResource Icon.Web}"
                                        Command="{Binding OpenSubjectListingCommand}" ToolTip="{Binding SubjectUrl}"
                                        Visibility="{Binding SubjectUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Content="Edit" Tag="{StaticResource Icon.Edit}" Style="{StaticResource Theme.ToggleButton.Outline.Small}"
                                          IsChecked="{Binding IsEditingSubject}" VerticalAlignment="Top" ToolTip="Edit the property's details"/>
                        </Grid>

                        <!-- the boxes -->
                        <Border Style="{StaticResource Theme.Border.Collapsible}" Tag="{Binding IsEditingSubject}">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Address" Style="{StaticResource Label}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Text="Acres" Style="{StaticResource Label}"/>
                            <WrapPanel Grid.Row="1" Grid.Column="1">
                                <TextBox Text="{Binding AcresText, UpdateSourceTrigger=PropertyChanged}" Width="80" Style="{StaticResource Field}"/>
                                <TextBlock Text="Zip" Style="{StaticResource Label}" Margin="10,0,4,0"/>
                                <TextBox Text="{Binding ZipText, UpdateSourceTrigger=PropertyChanged}" Width="70" MaxLength="5" Style="{StaticResource Field}"/>
                                <CheckBox Content="House" IsChecked="{Binding IsHome}" VerticalAlignment="Center" Margin="10,0,0,0"
                                          ToolTip="Value the house: $/sqft x its sqft (or the median price without a sqft), comparing home size, beds and baths instead of the lot"/>
                            </WrapPanel>
                            <!-- the house, from the county record or the appraiser; blank boxes are simply not compared -->
                            <TextBlock Grid.Row="2" Text="Sqft" Style="{StaticResource Label}"
                                       Visibility="{Binding IsHome, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                                       Visibility="{Binding IsHome, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox Text="{Binding HomeSqftText, UpdateSourceTrigger=PropertyChanged}" Width="80" Style="{StaticResource Field}" ToolTip="The house's living area in square feet (property appraiser)"/>
                                <TextBlock Text="Beds" Style="{StaticResource Label}" Margin="10,0,4,0"/>
                                <TextBox Text="{Binding BedsText, UpdateSourceTrigger=PropertyChanged}" Width="34" Style="{StaticResource Field}"/>
                                <TextBlock Text="Baths" Style="{StaticResource Label}" Margin="8,0,4,0"/>
                                <TextBox Text="{Binding BathsText, UpdateSourceTrigger=PropertyChanged}" Width="34" Style="{StaticResource Field}"/>
                                <CheckBox Content="Mobile home" IsChecked="{Binding IsMobile}" VerticalAlignment="Center" Margin="10,4,0,4"
                                          ToolTip="Mobile and manufactured homes sell in a different market: comps of the other kind are flagged as outliers"/>
                                <CheckBox Content="Duplex / multi" IsChecked="{Binding IsMultiFamily}" VerticalAlignment="Center" Margin="10,4,0,4"
                                          ToolTip="A duplex or other 2-4 unit building (appraiser land use 'Multifamily'): Zillow is searched for multi-family sales, and single-family comps are flagged as outliers. Use the building's total sqft, beds and baths."/>
                                <CheckBox Content="Condo / villa" IsChecked="{Binding IsCondo}" VerticalAlignment="Center" Margin="10,4,0,4"
                                          ToolTip="An attached home: condo, villa or townhouse (shares a wall, usually an HOA). Zillow is searched for condos and townhouses, and detached houses are flagged as outliers."/>
                            </WrapPanel>
                        </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- what the last search did: a quiet note, hidden while there is nothing to say -->
                <DockPanel Margin="2,0,2,8">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Message}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <Path Style="{StaticResource InfoIcon}" VerticalAlignment="Top" Margin="0,2,6,0"/>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                </DockPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" Padding="0,0,4,0">
                <StackPanel>
                    <!-- the value and the figures behind it; the rate box and View on Map underneath -->
                    <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Pill.Background}" Padding="14,12"
                            Visibility="{Binding HasComps, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Estimated Market Value" Style="{StaticResource Label}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"/>
                                        <Border Background="Transparent" ToolTip="{Binding ValueHow}" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <Path Style="{StaticResource InfoIcon}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding EstimateText}" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Rectangle Grid.Column="1" Width="1" Style="{StaticResource Divider}" Margin="10,2"/>
                                <!-- 2 x 2: averages, median, and how many comps were read -->
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource Divider}"/>
                                    <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Divider}"/>
                                    <StackPanel Style="{StaticResource Stat}">
                                        <TextBlock Text="{Binding AvgPrice, StringFormat={}{0:C0}}" Style="{StaticResource StatValue}"/>
                                        <TextBlock Text="Avg Price" Style="{StaticResource StatLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Style="{StaticResource Stat}">
                                        <TextBlock Text="{Binding MedianPrice, StringFormat={}{0:C0}}" Style="{StaticResource StatValue}"/>
                                        <TextBlock Text="Median Price" Style="{StaticResource StatLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Style="{StaticResource Stat}">
                                        <TextBlock Text="{Binding AvgPpa, StringFormat={}{0:C0}}" Style="{StaticResource StatValue}"/>
                                        <TextBlock Style="{StaticResource StatLabel}"><Run Text="Avg "/><Run Text="{Binding RateHead, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource Stat}">
                                        <TextBlock Text="{Binding Visible.Count}" Style="{StaticResource StatValue}"/>
                                        <TextBlock Text="Comps" Style="{StaticResource StatLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <!-- the rate behind the value (editable to override it), and the map -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RateLabel}" Style="{StaticResource Label}" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding PpaText, UpdateSourceTrigger=PropertyChanged}" Width="90" Style="{StaticResource Field}" ToolTip="{Binding ValueHow}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="View on Map" Tag="{StaticResource Icon.MapMarker}" Style="{StaticResource Theme.Button.Outline.Small}"
                                        VerticalAlignment="Center" Command="{Binding ReviewOnMapCommand}" ToolTip="Show the comps on a map"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- filters (collapsible) -->
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <StackPanel>
                            <ToggleButton x:Name="FiltersToggle" IsChecked="False" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Stretch="None" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center" Data="{StaticResource Icon.Line.Sliders}"/>
                                                <TextBlock Text="Filters" Style="{StaticResource Title}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                                <TextBlock Text="{Binding FiltersSummary}" Style="{StaticResource Title}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Opacity="0.7" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Path Grid.Column="2" x:Name="Chevron" Data="{StaticResource Icon.Line.ChevronUp}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform><RotateTransform Angle="180"/></Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border Style="{StaticResource Theme.Border.Collapsible}" Tag="{Binding IsChecked, ElementName=FiltersToggle}">
                            <StackPanel Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <!-- each group: a heading, then Min | Max side by side -->
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Acreage" Style="{StaticResource FilterHead}"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,3,0">
                                                <!-- Min / Max look like labels; clicking one fills a size band around the property's lot -->
                                                <TextBlock Text="Min" Style="{StaticResource FilterSub}" Cursor="Hand" ToolTip="{Binding MinAcresTip}">
                                                    <TextBlock.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding FillAcresCommand}" CommandParameter="Min"/></TextBlock.InputBindings>
                                                </TextBlock>
                                                <TextBox Text="{Binding MinAcres, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                                            </StackPanel>
                                            <StackPanel Margin="3,0,0,0">
                                                <TextBlock Text="Max" Style="{StaticResource FilterSub}" Cursor="Hand" ToolTip="{Binding MaxAcresTip}">
                                                    <TextBlock.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding FillAcresCommand}" CommandParameter="Max"/></TextBlock.InputBindings>
                                                </TextBlock>
                                                <TextBox Text="{Binding MaxAcres, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                        <TextBlock Text="Price" Style="{StaticResource FilterHead}"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,3,0">
                                                <TextBlock Text="Min" Style="{StaticResource FilterSub}"/>
                                                <TextBox Text="{Binding MinPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                                            </StackPanel>
                                            <StackPanel Margin="3,0,0,0">
                                                <TextBlock Text="Max" Style="{StaticResource FilterSub}"/>
                                                <TextBox Text="{Binding MaxPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                        <TextBlock Text="$/Acre" Style="{StaticResource FilterHead}"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,3,0">
                                                <TextBlock Text="Min" Style="{StaticResource FilterSub}"/>
                                                <TextBox Text="{Binding MinPpa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                                            </StackPanel>
                                            <StackPanel Margin="3,0,0,0">
                                                <TextBlock Text="Max" Style="{StaticResource FilterSub}"/>
                                                <TextBox Text="{Binding MaxPpa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Content="Median" IsChecked="{Binding UseMedian}" VerticalAlignment="Center"/>
                                        <Path Style="{StaticResource InfoIcon}" Margin="5,0,14,0"
                                              ToolTip="Value from the weighted median (close, recent, similar comps count more). Untick for the plain average."/>
                                        <CheckBox Content="Top 5" IsChecked="{Binding UseTopFive}" IsEnabled="{Binding HasSubject}" VerticalAlignment="Center"/>
                                        <Path Style="{StaticResource InfoIcon}" Margin="5,0,0,0"
                                              ToolTip="Value from the 5 best matches only (highest weight). The rest stay listed and on the map, faded; remove one and the next best moves up, or Include anyway to add one."/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Clear Filters" Tag="{StaticResource Icon.Refresh}" Style="{StaticResource Theme.Button.Outline.Small}"
                                            Command="{Binding ClearFiltersCommand}"/>
                                </Grid>
                            </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- comparable properties: count, restore, sort -->
                    <Border Padding="2,2,0,0" Margin="0,0,0,10"
                            Visibility="{Binding HasComps, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Home}" Style="{StaticResource Glyph}" Margin="0,0,8,0"/>
                                    <TextBlock Style="{StaticResource Title}" FontWeight="SemiBold">
                                        <Run Text="Comparables"/>
                                        <Run Text="{Binding Visible.Count, Mode=OneWay, StringFormat=({0})}" Foreground="{DynamicResource Brush.Accent}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Content="Restore removed" Style="{StaticResource IconLink}" Tag="{StaticResource Icon.Refresh}"
                                        ToolTip="Bring back every comp removed by hand, on the map, or left out as an outlier"
                                        Command="{Binding ShowRemovedCommand}" Visibility="{Binding HasRemoved, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sort by:" Style="{StaticResource Label}" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" MinWidth="130" Style="{StaticResource Theme.ComboBox.Light}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- the comps -->
                    <ItemsControl ItemsSource="{Binding Visible}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                            <Style.Triggers>
                                                <!-- left out of the value (outlier, removed, outside the top 5) -->
                                                <DataTrigger Binding="{Binding IsExcluded}" Value="True"><Setter Property="Opacity" Value="0.6"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- the listing's photo (loaded from the site when shown); a house icon when there is none -->
                                        <Grid Height="84" VerticalAlignment="Top">
                                            <Border Style="{StaticResource PhotoTile}">
                                                <Path Style="{StaticResource PhotoTile.Icon}"/>
                                            </Border>
                                            <Border CornerRadius="8">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding PhotoUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Headline}" Style="{StaticResource Title}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="✕" Style="{StaticResource Theme.Button.IconOnly}" FontSize="11" Padding="4,0" Margin="4,0,0,0" VerticalAlignment="Top" ToolTip="Remove this comp"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Price, StringFormat='{}{0:C0}'}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                                <Path Data="{StaticResource Icon.Calendar}" Style="{StaticResource Glyph}" Width="12" Height="12" Opacity="0.6" Margin="10,0,4,0"/>
                                                <TextBlock Text="{Binding DateText}" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding RateLine}" Style="{StaticResource Sub}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            <!-- tags: how well it matches (hover for the weight and why), data to check, misleading sales -->
                                            <WrapPanel Margin="0,2,0,0">
                                                <Border ToolTip="{Binding WeightTip}"
                                                        Visibility="{Binding DataContext.HasSubject, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Tag}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MatchLevel}" Value="Strong">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Status.Success}"/>
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Status.Success.Foreground}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding MatchLevel}" Value="Fair">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Status.Warning}"/>
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Status.Warning.Foreground}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource Tag.Icon}"/>
                                                        <TextBlock Text="{Binding MatchLabel}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border ToolTip="{Binding Verify}">
                                                    <TextBlock Text="VERIFY"/>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Tag.Warning}">
                                                            <Style.Triggers><DataTrigger Binding="{Binding Verify}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <Border ToolTip="{Binding OutlierTip}">
                                                    <TextBlock Text="OUTLIER"/>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Tag.Danger}">
                                                            <Style.Triggers><DataTrigger Binding="{Binding Outlier}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </WrapPanel>
                                            <!-- why it is left out, and the way back in -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers><DataTrigger Binding="{Binding LeftOutWhy}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding LeftOutWhy}" ToolTip="{Binding OutlierTip}" FontSize="11" Foreground="{DynamicResource Brush.Status.Danger.Foreground}" TextWrapping="Wrap" MaxWidth="140" VerticalAlignment="Center"/>
                                                <Button Content="Include anyway" Margin="6,0,0,0" Style="{StaticResource Theme.Button.Outline.Small}" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.IncludeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding IsExcluded, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <!-- the address opens the listing in the default browser -->
                                            <Button Margin="0,4,0,0" HorizontalAlignment="Left" Cursor="Hand" ToolTip="Open the listing in your browser" Click="OnListingClick">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                                            <Path Data="{StaticResource Icon.MapMarker}" Style="{StaticResource Glyph}" Width="12" Height="12" Margin="0,0,4,0"/>
                                                            <TextBlock x:Name="Link" Text="{Binding Address}" Style="{StaticResource Label}" Foreground="{DynamicResource Brush.Accent}" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Link" Property="TextDecorations" Value="Underline"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <!-- Analyze progress over the list (the shared busy overlay) -->
            <Grid Grid.Row="1" Visibility="{Binding ShowListOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <local:ScrapeOverlay/>
            </Grid>

            <!-- how far to trust the value (shown in the card above), and sending it back; hidden while it would be empty -->
            <Border Grid.Row="2" CornerRadius="12" Padding="14,10" Background="{DynamicResource Brush.Background.Secondary}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Margin" Value="0,4,24,8"/> <!-- ScrollGutter, plus the gap above and below -->
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowConfidence}" Value="False"/>
                                    <Condition Binding="{Binding HasTarget}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ConfidenceText}"
                                Visibility="{Binding ShowConfidence, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Margin="0,0,10,0" Padding="8,3">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Tag.Danger}">
                                    <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.Small}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConfidenceLevel}" Value="High">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Status.Success}"/>
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Status.Success.Foreground}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConfidenceLevel}" Value="Medium">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Status.Warning}"/>
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Status.Warning.Foreground}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Tag.Icon}"/>
                                <TextBlock><Run Text="{Binding ConfidenceLevel, Mode=OneWay}"/><Run Text=" confidence"/></TextBlock>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Sub}" VerticalAlignment="Center">
                            <Run Text="Based on"/> <Run Text="{Binding Count, Mode=OneWay}"/> <Run Text="selected properties"/>
                        </TextBlock>
                    </StackPanel>
                    <!-- only when opened from a pin or a grid row -->
                    <Border Style="{StaticResource Theme.Border.PillGroup}" Margin="0,10,0,0"
                            Visibility="{Binding HasTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <UniformGrid Columns="2">
                            <Button Content="Return" Tag="{StaticResource Icon.ArrowLeft}" Style="{StaticResource Theme.Button.Pill}" Command="{Binding BackWithoutSavingCommand}"/>
                            <Button Content="Apply Value" Tag="{StaticResource Icon.Check}" Style="{StaticResource Theme.Button.Pill.On}" Command="{Binding UseCompsCommand}"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
