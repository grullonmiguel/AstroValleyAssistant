                                </HeaderedContentControl.Header>
                                <WrapPanel>
                                    <Button Content="Auction page" Style="{StaticResource Theme.Dialog.Button.Link}" Margin="0,0,10,4" CommandParameter="{Binding AuctionUrl}"
                                            Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
