<UserControl x:Class="AstroValley.Presentation.Views.MyPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AstroValley.Presentation.ViewModels">
    <!-- My Properties (MyPropertiesViewModel). Left: the properties, with search and Add. Right: the selected property, read-only cards whose
         Edit button opens a small dialog (SectionEditView), then collapsible sections for the tables. Uses the shared dialog card styles. -->
    <UserControl.Resources>
        <Style x:Key="NumericCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Field" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Theme.Dialog.Text.Small}">
            <Setter Property="Width" Value="118"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <!-- a figure the app works out: shown, not typed -->
        <Style x:Key="Computed" TargetType="TextBlock" BasedOn="{StaticResource Theme.Dialog.Text}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style x:Key="LongText" TargetType="TextBox" BasedOn="{StaticResource Theme.TextBox}">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="MaxHeight" Value="220"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <!-- one read-only line of a card: label on the left, value filling the rest -->
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Theme.Dialog.Text}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Card" TargetType="HeaderedContentControl" BasedOn="{StaticResource Theme.Dialog.Card}">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="EditButton" TargetType="Button" BasedOn="{StaticResource Theme.Dialog.Button.Outline}">
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="EditGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="CanUserAddRows" Value="True"/>
            <Setter Property="CanUserDeleteRows" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinRowHeight" Value="30"/>
            <Setter Property="MaxHeight" Value="260"/>
        </Style>

        <!-- a collapsible section: a card whose header (icon = Tag, title = Header, one line under it) opens and closes the content.
             HeaderStringFormat carries that second line: Expander has no property for it, and this one is otherwise unused here. -->
        <Style x:Key="Section" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{DynamicResource Brush.Background.Secondary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top" Cursor="Hand" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="16,12"><ContentPresenter/></Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <DockPanel>
                                        <Path x:Name="Chevron" DockPanel.Dock="Right" Data="{StaticResource Icon.Line.ChevronUp}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2"
                                              Width="14" Height="8" Stretch="Fill" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform><RotateTransform Angle="180"/></Path.RenderTransform>
                                        </Path>
                                        <Path DockPanel.Dock="Left" Style="{StaticResource Theme.Dialog.Icon}" VerticalAlignment="Center" Margin="0,0,14,0"
                                              Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" FontSize="{StaticResource FontSize.Normal}" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Accent.Tertiary}"/>
                                            <TextBlock Text="{Binding HeaderStringFormat, RelativeSource={RelativeSource AncestorType=Expander}}" Style="{StaticResource Theme.Dialog.Text.Small}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </ToggleButton>
                                <!-- slides open and closed like the Comps sidebar's sections -->
                                <Border Style="{StaticResource Theme.Border.Collapsible}" Tag="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ContentPresenter Margin="16,2,16,14"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a property in the sidebar: aerial thumbnail, address, place, status -->
        <DataTemplate x:Key="PropertyRow">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="6" Margin="0,0,10,0" Background="{DynamicResource Brush.Background.Hover}">
                    <Grid>
                        <Path Data="{StaticResource Icon.MapOutline}" Fill="{DynamicResource Brush.Accent}" Width="22" Height="22" Stretch="Uniform" Opacity="0.5"/>
                        <Image Source="{Binding AerialPhoto}" Stretch="UniformToFill"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Accent.Tertiary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CityLine}" Style="{StaticResource Theme.Dialog.Text.Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Theme.Dialog.Text.Small}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Model.IsSold}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Status.Success.Foreground}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        
        <Style x:Key="PropertyRowContainer" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="8" Padding="8" Margin="0,0,0,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Background.Hover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Background.Hover}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource ViewSlideInFromTopStyle}" Margin="0 0 16 16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Property List -->
        <Border Grid.Column="1" Background="{DynamicResource Brush.Background.Secondary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,14,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Command="{Binding AddCommand}" Style="{StaticResource Theme.Button.Outline}" Padding="7" BorderThickness="1" ToolTip="Add a property">
                        <Path Data="{StaticResource Icon.Plus}" Fill="{DynamicResource Brush.Accent}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <TextBlock Text="My Properties" FontSize="{StaticResource FontSize.Large}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Tertiary}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Search properties..." Margin="0,0,0,8"
                         ToolTip="Address, city, parcel ID or lot number"/>
                <ComboBox DockPanel.Dock="Top" ItemsSource="{x:Static vm:MyPropertiesViewModel.StatusFilters}" SelectedItem="{Binding StatusFilter}" Style="{StaticResource Theme.ComboBox.Light}"
                          Margin="0,0,0,10" ToolTip="Show only the properties at this stage"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding TotalsLines}" Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,10,0,0"/>
                <Grid>
                    <ListBox ItemsSource="{Binding Properties}" SelectedItem="{Binding Selected, Mode=TwoWay}" ItemTemplate="{StaticResource PropertyRow}"
                             ItemContainerStyle="{StaticResource PropertyRowContainer}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    <TextBlock Text="No properties yet. Press + to add one, or use Import in the menu on the right." Style="{StaticResource Theme.Dialog.Text.Small}" Margin="4,12" VerticalAlignment="Top"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Selected property -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,8,0,0"/>

            <!-- address, quick facts and the menu -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,10,10">
                <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource Theme.Button.Outline}" Padding="9" BorderThickness="1" VerticalAlignment="Top" ToolTip="More actions" Click="OnMoreClicked">
                    <Path Data="{StaticResource Icon.DotsVertical}" Fill="{DynamicResource Brush.Accent}" Width="16" Height="16" Stretch="Uniform"/>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MoreMenu" Placement="Bottom" Style="{StaticResource Theme.ContextMenu}">
                            <MenuItem Header="Copy brief for Claude" Command="{Binding CopyBriefCommand}" Style="{StaticResource Theme.ContextMenuItem}"/>
                            <MenuItem Header="Paste Claude's results" Command="{Binding PasteResearchCommand}" Style="{StaticResource Theme.ContextMenuItem}"/>
                            <MenuItem Header="Term sheet" Command="{Binding ExportTermSheetCommand}" Style="{StaticResource Theme.ContextMenuItem}"/>
                            <MenuItem Header="Add documents or photos" Command="{Binding AddFilesCommand}" Style="{StaticResource Theme.ContextMenuItem}"/>
                            <MenuItem Header="Open this property's folder" Command="{Binding OpenDocumentsCommand}" Style="{StaticResource Theme.ContextMenuItem}"/>
                            <Separator Margin="0" Background="{DynamicResource Brush.Border}"/>
                            <MenuItem Header="Export this property (JSON)" Command="{Binding ExportCommand}" Style="{StaticResource Theme.ContextMenuItem}"/>
                            <MenuItem Header="Import properties (JSON)" Command="{Binding ImportCommand}" Style="{StaticResource Theme.ContextMenuItem}"/>
                            <MenuItem Header="Export all to Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource Theme.ContextMenuItem}"/>
                            <MenuItem Header="Open the data folder" Command="{Binding OpenFolderCommand}" Style="{StaticResource Theme.ContextMenuItem}"/>
                            <Separator Margin="0" Background="{DynamicResource Brush.Border}"/>
                            <MenuItem Header="Delete this property" Command="{Binding DeleteCommand}" Style="{StaticResource Theme.ContextMenuItem}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.MapMarker}" Fill="{DynamicResource Brush.Accent}" Width="22" Height="22" Stretch="Uniform" Margin="0,4,12,0" VerticalAlignment="Top"
                      Visibility="{Binding Selected, Converter={StaticResource NullToVisibilityConverter}}"/>
                <StackPanel>
                    <TextBlock Text="{Binding Selected.FullAddress, FallbackValue='My Properties'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Tertiary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Selected.HeaderFacts}" Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- whatever needs attention, across every property -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Status.Warning}" CornerRadius="8" Padding="12,6" Margin="0,0,10,10"
                    Visibility="{Binding HasReminders, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Reminders}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Status.Warning.Foreground}" FontWeight="SemiBold" Margin="0,1"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ScrollViewer x:Name="Detail" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                          Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <!-- the figures that matter -->
                    <Border Background="{DynamicResource Brush.Background.Secondary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12,14" Margin="0,0,10,10">
                        <UniformGrid Rows="1">
                            <DockPanel Margin="8,0">
                                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Scale}" Fill="{DynamicResource Brush.Accent}" Width="26" Height="26" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Total Spent" Style="{StaticResource Theme.Dialog.Text.Small}"/>
                                    <TextBlock Text="{Binding Model.TotalSpent, StringFormat={}{0:C0}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Tertiary}"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="8,0">
                                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Building}" Fill="{DynamicResource Brush.Accent}" Width="26" Height="26" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Market Value" Style="{StaticResource Theme.Dialog.Text.Small}"/>
                                    <TextBlock Text="{Binding MarketValue, StringFormat={}{0:C0}, TargetNullValue='–'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Tertiary}"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="8,0">
                                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Check}" Fill="{DynamicResource Brush.Accent}" Width="26" Height="26" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProfitLabel}" Style="{StaticResource Theme.Dialog.Text.Small}"/>
                                    <TextBlock Text="{Binding ProfitValue, StringFormat={}{0:C0}, TargetNullValue='–'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.Success.Foreground}"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="8,0">
                                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.List.Numbered}" Fill="{DynamicResource Brush.Accent}" Width="26" Height="26" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Return" Style="{StaticResource Theme.Dialog.Text.Small}"/>
                                    <TextBlock Text="{Binding ProfitPercent, StringFormat={}{0:N0}%, TargetNullValue='–'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Tertiary}" ToolTip="Profit over everything spent"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="8,0">
                                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Info}" Fill="{DynamicResource Brush.Accent}" Width="26" Height="26" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Status" Style="{StaticResource Theme.Dialog.Text.Small}"/>
                                    <TextBlock Text="{Binding Status}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Tertiary}"/>
                                </StackPanel>
                            </DockPanel>
                        </UniformGrid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*" MinWidth="330"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <HeaderedContentControl Tag="{StaticResource Icon.Home}" Style="{StaticResource Card}">
                                <HeaderedContentControl.Header>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Edit" Tag="{StaticResource Icon.Edit}" Style="{StaticResource EditButton}" CommandParameter="Property"
                                                Command="{Binding DataContext.EditSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <TextBlock Text="Property Information" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Normal}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Tertiary}"/>
                                    </DockPanel>
                                </HeaderedContentControl.Header>
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Address" Style="{StaticResource Label}"/><TextBlock Text="{Binding Address}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="City" Style="{StaticResource Label}"/><TextBlock Text="{Binding City}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="County" Style="{StaticResource Label}"/><TextBlock Text="{Binding County}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="State / ZIP" Style="{StaticResource Label}"/><TextBlock Text="{Binding StateZip}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Parcel ID" Style="{StaticResource Label}"/><TextBlock Text="{Binding ParcelId}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Lot No" Style="{StaticResource Label}"/><TextBlock Text="{Binding LotNumber}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Purchased by" Style="{StaticResource Label}"/><TextBlock Text="{Binding PurchasedBy}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Owner of record" Style="{StaticResource Label}"/><TextBlock Text="{Binding Owner}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Property type" Style="{StaticResource Label}"/><TextBlock Text="{Binding PropertyType}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Zoning" Style="{StaticResource Label}"/><TextBlock Text="{Binding ZoningText}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Flood zone" Style="{StaticResource Label}"/><TextBlock Text="{Binding FloodZone}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Assessed" Style="{StaticResource Label}"/><TextBlock Text="{Binding AssessedValue, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Legal description" Style="{StaticResource Label}"/><TextBlock Text="{Binding LegalDescription}" Style="{StaticResource Value}" TextWrapping="Wrap" MaxHeight="90" TextTrimming="CharacterEllipsis" ToolTip="{Binding LegalDescription}"/></DockPanel>
                                </StackPanel>
                            </HeaderedContentControl>
                            <HeaderedContentControl Tag="{StaticResource Icon.MapOutline}" Style="{StaticResource Card}">
                                <HeaderedContentControl.Header>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Edit" Tag="{StaticResource Icon.Edit}" Style="{StaticResource EditButton}" CommandParameter="Lot"
                                                Command="{Binding DataContext.EditSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <TextBlock Text="Lot &amp; Dimensions" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Normal}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Tertiary}"/>
                                    </DockPanel>
                                </HeaderedContentControl.Header>
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Dimensions (ft)" Style="{StaticResource Label}"/><TextBlock Text="{Binding Size}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Area" Style="{StaticResource Label}"/><TextBlock Text="{Binding LotSummary}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Acres (county)" Style="{StaticResource Label}"/><TextBlock Text="{Binding ScrapedAcres, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Corner lot" Style="{StaticResource Label}"/><TextBlock Text="{Binding CornerLotText}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Road frontage" Style="{StaticResource Label}"/><TextBlock Text="{Binding RoadFrontageText}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Easements" Style="{StaticResource Label}"/><TextBlock Text="{Binding Easements}" Style="{StaticResource Value}" TextWrapping="Wrap"/></DockPanel>
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <HeaderedContentControl Tag="{StaticResource Icon.Scale}" Style="{StaticResource Card}">
                                <HeaderedContentControl.Header>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Edit" Tag="{StaticResource Icon.Edit}" Style="{StaticResource EditButton}" CommandParameter="Purchase"
                                                Command="{Binding DataContext.EditSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <TextBlock Text="Purchase Information" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Normal}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Tertiary}"/>
                                    </DockPanel>
                                </HeaderedContentControl.Header>
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Purchase date" Style="{StaticResource Label}"/><TextBlock Text="{Binding PurchaseDate, StringFormat=d, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Starting bid" Style="{StaticResource Label}"/><TextBlock Text="{Binding StartingBid, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Purchase price" Style="{StaticResource Label}"/><TextBlock Text="{Binding PurchasePrice, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Buyer's premium" Style="{StaticResource Label}"/><TextBlock Text="{Binding PremiumText}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Taxes at purchase" Style="{StaticResource Label}"/><TextBlock Text="{Binding TaxesAtPurchase, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Deed fee" Style="{StaticResource Label}"/><TextBlock Text="{Binding DeedFee, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Purchase total" Style="{StaticResource Label}"/><TextBlock Text="{Binding Model.PurchaseTotal, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Value}" FontWeight="Bold"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Deed type" Style="{StaticResource Label}"/><TextBlock Text="{Binding DeedType}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Deed recorded" Style="{StaticResource Label}"/><TextBlock Text="{Binding DeedRecordedDate, StringFormat=d, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Liber / instrument" Style="{StaticResource Label}"/><TextBlock Text="{Binding DeedInstrument}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Next tax due" Style="{StaticResource Label}"/><TextBlock Text="{Binding NextTaxDue, StringFormat=d, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                </StackPanel>
                            </HeaderedContentControl>
                            <HeaderedContentControl Tag="{StaticResource Icon.Cog}" Style="{StaticResource Card}">
                                <HeaderedContentControl.Header>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Edit" Tag="{StaticResource Icon.Edit}" Style="{StaticResource EditButton}" CommandParameter="Utilities"
                                                Command="{Binding DataContext.EditSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <TextBlock Text="Utilities" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Normal}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Tertiary}"/>
                                    </DockPanel>
                                </HeaderedContentControl.Header>
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Electricity" Style="{StaticResource Label}"/><TextBlock Text="{Binding ElectricityText}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Water" Style="{StaticResource Label}"/><TextBlock Text="{Binding WaterText}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Sewer" Style="{StaticResource Label}"/><TextBlock Text="{Binding SewerText}" Style="{StaticResource Value}"/></DockPanel>
