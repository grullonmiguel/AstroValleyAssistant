<UserControl x:Class="AstroValley.Presentation.Views.MyPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AstroValley.Presentation.ViewModels">
    <!-- My Properties (MyPropertiesViewModel): the list of owned properties on top, the selected one's editor below. Uses the shared dialog card styles. -->
    <UserControl.Resources>
        <Style x:Key="NumericCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- one field: the label on the left (a TextBlock), the input filling the rest -->
        <Style x:Key="Field" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Theme.Dialog.Text.Small}">
            <Setter Property="Width" Value="118"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <!-- a figure the app works out: shown, not typed -->
        <Style x:Key="Computed" TargetType="TextBlock" BasedOn="{StaticResource Theme.Dialog.Text}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style x:Key="Card" TargetType="HeaderedContentControl" BasedOn="{StaticResource Theme.Dialog.Card}">
            <Setter Property="Width" Value="390"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="WideCard" TargetType="HeaderedContentControl" BasedOn="{StaticResource Theme.Dialog.Card}">
            <Setter Property="Width" Value="790"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="LongText" TargetType="TextBox" BasedOn="{StaticResource Theme.TextBox}">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="MaxHeight" Value="220"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style x:Key="EditGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="CanUserAddRows" Value="True"/>
            <Setter Property="CanUserDeleteRows" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinRowHeight" Value="30"/>
            <Setter Property="MaxHeight" Value="260"/>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource ViewSlideInFromTopStyle}" Margin="0 0 16 16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: totals and actions -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Delete" Tag="{StaticResource Icon.Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource Theme.Dialog.Button.Outline}" Padding="14,6"
                        ToolTip="Move the selected property's file to the Recycle Bin"/>
                <Button Content="Export" Tag="{StaticResource Icon.Save}" Command="{Binding ExportCommand}" Style="{StaticResource Theme.Dialog.Button.Outline}" Padding="14,6"
                        ToolTip="Save a copy of the selected property as a JSON file"/>
                <Button Content="Import" Tag="{StaticResource Icon.TrayDown}" Command="{Binding ImportCommand}" Style="{StaticResource Theme.Dialog.Button.Outline}" Padding="14,6"
                        ToolTip="Add properties from one or more JSON files"/>
                <Button Content="Open folder" Tag="{StaticResource Icon.Web.Search}" Command="{Binding OpenFolderCommand}" Style="{StaticResource Theme.Dialog.Button.Outline}" Padding="14,6"
                        ToolTip="Show the saved files, one per property; back this folder up"/>
                <Button Content="Add property" Tag="{StaticResource Icon.Plus}" Command="{Binding AddCommand}" Style="{StaticResource Theme.Dialog.Button.Primary}" Padding="16,7"/>
            </StackPanel>
            <ComboBox DockPanel.Dock="Left" ItemsSource="{x:Static vm:MyPropertiesViewModel.StatusFilters}" SelectedItem="{Binding StatusFilter}" Style="{StaticResource Theme.ComboBox.Light}"
                      Width="140" Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="Show only the properties at this stage"/>
            <TextBlock Text="{Binding Totals}" Style="{StaticResource Theme.Dialog.Text}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Row 1: the list -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Properties}" SelectedItem="{Binding Selected, Mode=TwoWay}" FontSize="13" MinRowHeight="34" MaxHeight="250">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Lot #" Binding="{Binding LotNumber}" Width="Auto"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Title}" Width="*" MinWidth="160"/>
                <DataGridTextColumn Header="Acres" Binding="{Binding Model.Acres, StringFormat={}{0:0.##}}" Width="Auto" ElementStyle="{StaticResource NumericCellStyle}"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto"/>
                <DataGridTextColumn Header="Assessed" Binding="{Binding AssessedValue, StringFormat={}{0:C}}" Width="Auto" ElementStyle="{StaticResource NumericCellStyle}"/>
                <DataGridTextColumn Header="Purchased" Binding="{Binding PurchasePrice, StringFormat={}{0:C}}" Width="Auto" ElementStyle="{StaticResource NumericCellStyle}"/>
                <DataGridTextColumn Header="Total Spent" Binding="{Binding Model.TotalSpent, StringFormat={}{0:C}}" Width="Auto" ElementStyle="{StaticResource NumericCellStyle}"/>
                <DataGridTextColumn Header="Market Value" Binding="{Binding MarketValue, StringFormat={}{0:C}}" Width="Auto" ElementStyle="{StaticResource NumericCellStyle}" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Gain" Binding="{Binding Model.MarketGainPercent, StringFormat={}{0:N0}%, TargetNullValue=''}" Width="Auto" ElementStyle="{StaticResource NumericCellStyle}" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Min %" Binding="{Binding MinimumSalePercent, StringFormat={}{0:0.##}%}" Width="Auto" ElementStyle="{StaticResource NumericCellStyle}"/>
                <DataGridTextColumn Header="Minimum Sale" Binding="{Binding Model.MinimumSale, StringFormat={}{0:C}}" Width="Auto" ElementStyle="{StaticResource NumericCellStyle}"/>
                <DataGridTextColumn Header="Min Gain" Binding="{Binding Model.MinimumSaleGainPercent, StringFormat={}{0:N2}%, TargetNullValue=''}" Width="Auto" ElementStyle="{StaticResource NumericCellStyle}"/>
                <DataGridTextColumn Header="Purchased By" Binding="{Binding PurchasedBy}" Width="Auto"/>
                <DataGridTextColumn Header="Zoning" Binding="{Binding ZoningCode}" Width="Auto"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="1" Grid.RowSpan="2" Text="No properties yet. Press Add property to enter one, or Import to load JSON files."
                   Style="{StaticResource Theme.Dialog.Text}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Row 2: the selected property -->
        <ScrollViewer Grid.Row="2" x:Name="Detail" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                      Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
            <WrapPanel>
                <HeaderedContentControl Header="Property Info" Tag="{StaticResource Icon.MapMarker}" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Address" Style="{StaticResource Label}"/><TextBox Text="{Binding Address}" Tag="2916 Mackinaw St"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="City" Style="{StaticResource Label}"/><TextBox Text="{Binding City}"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="County" Style="{StaticResource Label}"/><TextBox Text="{Binding County}" Tag="Saginaw County"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="State / ZIP" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding State}" Width="60" Tag="MI" MaxLength="2" DockPanel.Dock="Left" Margin="0,0,6,0"/><TextBox Text="{Binding Zip}"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Parcel ID" Style="{StaticResource Label}"/><TextBox Text="{Binding ParcelId}"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Lot No" Style="{StaticResource Label}"/><TextBox Text="{Binding LotNumber}" Tag="the auction's lot number"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Purchased by" Style="{StaticResource Label}"/><TextBox Text="{Binding PurchasedBy}" Tag="the buying company"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Owner of record" Style="{StaticResource Label}"/><TextBox Text="{Binding Owner}"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Property type" Style="{StaticResource Label}"/><TextBox Text="{Binding PropertyType}" Tag="Vacant land / Structures"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Zoning" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding ZoningCode}" Width="70" Tag="R-2" DockPanel.Dock="Left" Margin="0,0,6,0"/><TextBox Text="{Binding ZoningType}" Tag="Medium-Density Residential"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Flood zone" Style="{StaticResource Label}"/><TextBox Text="{Binding FloodZone}"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Assessed" Style="{StaticResource Label}"/><TextBox Text="{Binding AssessedValue, StringFormat=N2, TargetNullValue=''}"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Lat / Long" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Latitude}" Width="110" DockPanel.Dock="Left" Margin="0,0,6,0"/><TextBox Text="{Binding Longitude}"/></DockPanel>
                        <TextBlock Text="Legal description" Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,2,0,4"/>
                        <TextBox Text="{Binding LegalDescription}" Style="{StaticResource LongText}"/>
                    </StackPanel>
                </HeaderedContentControl>

                <StackPanel>
                    <HeaderedContentControl Header="Purchase Info" Tag="{StaticResource Icon.Scale}" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Purchase date" Style="{StaticResource Label}"/><TextBox Text="{Binding PurchaseDate, StringFormat=d, TargetNullValue=''}" Tag="m/d/yyyy"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Starting bid" Style="{StaticResource Label}"/><TextBox Text="{Binding StartingBid, StringFormat=N2, TargetNullValue=''}"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Purchase price" Style="{StaticResource Label}"/><TextBox Text="{Binding PurchasePrice, StringFormat=N2}"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Buyer's premium %" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding BuyerPremiumPercent, StringFormat=0.##}" Width="60" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Model.BuyerPremium, StringFormat={}{0:C}}" Style="{StaticResource Computed}"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Taxes at purchase" Style="{StaticResource Label}"/><TextBox Text="{Binding TaxesAtPurchase, StringFormat=N2}"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Deed fee" Style="{StaticResource Label}"/><TextBox Text="{Binding DeedFee, StringFormat=N2}"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Purchase total" Style="{StaticResource Label}"/><TextBlock Text="{Binding Model.PurchaseTotal, StringFormat={}{0:C}}" Style="{StaticResource Computed}"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Deed type" Style="{StaticResource Label}"/><TextBox Text="{Binding DeedType}" Tag="Treasurer / Quitclaim / Warranty"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Deed recorded" Style="{StaticResource Label}"/><TextBox Text="{Binding DeedRecordedDate, StringFormat=d, TargetNullValue=''}" Tag="m/d/yyyy"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Liber / instrument" Style="{StaticResource Label}"/><TextBox Text="{Binding DeedInstrument}"/></DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Lot" Tag="{StaticResource Icon.MapOutline}" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Width × depth (ft)" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding LotWidthFt, TargetNullValue=''}" Width="80" Tag="88" DockPanel.Dock="Left" Margin="0,0,6,0"/><TextBox Text="{Binding LotDepthFt, TargetNullValue=''}" Tag="120"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Area" Style="{StaticResource Label}"/><TextBlock Text="{Binding LotSummary}" Style="{StaticResource Computed}" FontWeight="Normal"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Acres (county)" Style="{StaticResource Label}"/><TextBox Text="{Binding ScrapedAcres, TargetNullValue=''}" ToolTip="Used until the width and depth are typed"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="" Style="{StaticResource Label}"/>
                                <CheckBox Content="Corner lot" IsChecked="{Binding CornerLot}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <CheckBox Content="Road frontage" IsChecked="{Binding RoadFrontage}" IsThreeState="True" VerticalAlignment="Center" ToolTip="Filled square = not checked yet"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Easements" Style="{StaticResource Label}"/><TextBox Text="{Binding Easements}" Tag="none known"/></DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>

                <StackPanel>
                    <HeaderedContentControl Header="Map and research" Tag="{StaticResource Icon.MapPin}" Style="{StaticResource Card}">
                        <StackPanel>
                            <!-- aerial photo with the parcel outline (Esri World Imagery), once the property has coordinates -->
                            <Border Height="190" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,8" Background="{DynamicResource Brush.Background.Hover}">
                                <Grid>
                                    <TextBlock Text="No aerial photo yet. Press Scrape to get the coordinates from Regrid." Style="{StaticResource Theme.Dialog.Text.Small}" Margin="12" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Grid Visibility="{Binding Aerial, Converter={StaticResource NullToVisibilityConverter}}" Background="{DynamicResource Brush.Background.Hover}">
                                        <Image Source="{Binding AerialPhoto}" Stretch="Fill"/>
                                        <Viewbox Stretch="Fill"><Canvas Width="179" Height="95">
                                            <Path Data="{Binding Aerial.OutlinePath}" Stroke="White" StrokeThickness="1.5" Fill="#22FFFFFF" StrokeLineJoin="Round"/>
                                        </Canvas></Viewbox>
                                    </Grid>
                                </Grid>
                            </Border>
                            <WrapPanel>
                                <Button Content="Scrape" Tag="{StaticResource Icon.Regrid}" Style="{StaticResource Theme.Dialog.Button.Outline}" Padding="9,5" Margin="0,0,6,6"
                                        Command="{Binding DataContext.ScrapeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Look this property up on Regrid and fill the empty fields. Anything you typed is kept."/>
                                <Button Content="Comps" Tag="{StaticResource Icon.Scale}" Style="{StaticResource Theme.Dialog.Button.Outline}" Padding="9,5" Margin="0,0,6,6"
                                        Command="{Binding DataContext.FindCompsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Open the Comps tab for this property; the value you send back is saved here"/>
                                <Button Content="Show on map" Tag="{StaticResource Icon.MapMarker}" Style="{StaticResource Theme.Dialog.Button.Outline}" Padding="9,5" Margin="0,0,0,6"
                                        Command="{Binding DataContext.ShowOnMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Go to this property's gold pin on the Home map"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Street View" Style="{StaticResource Theme.Dialog.Button.Link}" Margin="0" CommandParameter="{Binding StreetViewUrl}"
                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Button Content="Google Maps" Style="{StaticResource Theme.Dialog.Button.Link}" CommandParameter="{Binding GoogleMapsUrl}"
                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Button Content="Regrid" Style="{StaticResource Theme.Dialog.Button.Link}" CommandParameter="{Binding RegridUrl}"
                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Value and pricing" Tag="{StaticResource Icon.Building}" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Total spent" Style="{StaticResource Label}"/><TextBlock Text="{Binding Model.TotalSpent, StringFormat={}{0:C}}" Style="{StaticResource Computed}"
                                ToolTip="Purchase total plus every expense line"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Market value" Style="{StaticResource Label}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Model.MarketGainPercent, StringFormat={}{0:N0}% gain}" Style="{StaticResource Computed}" Margin="10,5,0,5"/>
                                <TextBox Text="{Binding MarketValue, StringFormat=N2, TargetNullValue=''}"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Minimum sale %" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding MinimumSalePercent, StringFormat=0.##}" Width="60" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                <TextBlock Style="{StaticResource Computed}">
                                    <Run Text="{Binding Model.MinimumSale, StringFormat={}{0:C}, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Model.MinimumSaleGainPercent, StringFormat={}{0:N0}%, Mode=OneWay}" ToolTip="Gain over total spent at the minimum sale price"/>
                                </TextBlock></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Comps" Style="{StaticResource Label}"/><TextBlock Text="{Binding CompsSummary}" Style="{StaticResource Computed}" FontWeight="Normal"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Asking price" Style="{StaticResource Label}"/><TextBox Text="{Binding AskingPrice, StringFormat=N2, TargetNullValue=''}"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Quick-sale price" Style="{StaticResource Label}"/><TextBox Text="{Binding QuickSalePrice, StringFormat=N2, TargetNullValue=''}"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Negotiation target" Style="{StaticResource Label}"/><TextBox Text="{Binding NegotiationTarget, StringFormat=N2, TargetNullValue=''}" ToolTip="What you expect to settle at"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Conservative value" Style="{StaticResource Label}"/><TextBox Text="{Binding ConservativeValue, StringFormat=N2, TargetNullValue=''}" ToolTip="The low end of what the comps support; the market value is the base case"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Optimistic value" Style="{StaticResource Label}"/><TextBox Text="{Binding OptimisticValue, StringFormat=N2, TargetNullValue=''}" ToolTip="The high end of what the comps support"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Status" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static vm:MyPropertiesViewModel.StatusOptions}" SelectedItem="{Binding Status}" Style="{StaticResource Theme.ComboBox.Light}"/></DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Utilities" Tag="{StaticResource Icon.Cog}" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Electricity" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static vm:MyPropertiesViewModel.UtilityOptions}" SelectedItem="{Binding Electricity}" Style="{StaticResource Theme.ComboBox.Light}"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Water" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static vm:MyPropertiesViewModel.UtilityOptions}" SelectedItem="{Binding Water}" Style="{StaticResource Theme.ComboBox.Light}"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Sewer" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static vm:MyPropertiesViewModel.UtilityOptions}" SelectedItem="{Binding Sewer}" Style="{StaticResource Theme.ComboBox.Light}"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Gas" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static vm:MyPropertiesViewModel.UtilityOptions}" SelectedItem="{Binding Gas}" Style="{StaticResource Theme.ComboBox.Light}"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Phone" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static vm:MyPropertiesViewModel.UtilityOptions}" SelectedItem="{Binding Phone}" Style="{StaticResource Theme.ComboBox.Light}"/></DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="County Info" Tag="{StaticResource Icon.Web}" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Auction page" Style="{StaticResource Label}"/>
                                <Button DockPanel.Dock="Right" Content="Open" Style="{StaticResource Theme.Dialog.Button.Link}" CommandParameter="{Binding AuctionUrl}"
                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <TextBox Text="{Binding AuctionUrl}" Tag="https://"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="GIS viewer" Style="{StaticResource Label}"/>
                                <Button DockPanel.Dock="Right" Content="Open" Style="{StaticResource Theme.Dialog.Button.Link}" CommandParameter="{Binding GisUrl}"
                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <TextBox Text="{Binding GisUrl}" Tag="https://"/></DockPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Property detail" Style="{StaticResource Label}"/>
                                <Button DockPanel.Dock="Right" Content="Open" Style="{StaticResource Theme.Dialog.Button.Link}" CommandParameter="{Binding PropertyDetailUrl}"
                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <TextBox Text="{Binding PropertyDetailUrl}" Tag="https://"/></DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>

                <HeaderedContentControl Header="Expenses" Tag="{StaticResource Icon.List.Numbered}" Style="{StaticResource WideCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,0,0,6"
                                   Text="Everything spent after the purchase: tax bills, grass cuts, signs. Type in the empty last row to add a line; select a row and press Delete to remove it."/>
                        <DataGrid x:Name="ExpensesGrid" ItemsSource="{Binding Model.Expenses}" Style="{StaticResource EditGrid}" RowEditEnding="OnRowEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="100"/>
                                <DataGridComboBoxColumn Header="Category" SelectedItemBinding="{Binding Category}" ItemsSource="{x:Static vm:MyPropertiesViewModel.ExpenseCategories}" Width="150"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="100" ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="Tax year" Binding="{Binding TaxYear, TargetNullValue=''}" Width="80"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Model.ExpensesTotal, StringFormat=Total {0:C}}" Style="{StaticResource Computed}" Margin="12,0,0,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding ExpensesByCategory}" Style="{StaticResource Theme.Dialog.Text.Small}"/>
                                <TextBlock Text="{Binding ExpensesByYear}" Style="{StaticResource Theme.Dialog.Text.Small}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="Neighbors" Tag="{StaticResource Icon.Person}" Style="{StaticResource WideCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,0,0,6" Text="The owners next door: often the first buyers to call."/>
                        <DataGrid x:Name="NeighborsGrid" ItemsSource="{Binding Model.Neighbors}" Style="{StaticResource EditGrid}" RowEditEnding="OnRowEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"/>
                                <DataGridTextColumn Header="Property address" Binding="{Binding PropertyAddress}" Width="*"/>
                                <DataGridTextColumn Header="Mailing address" Binding="{Binding MailingAddress}" Width="*"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="Profit at each price" Tag="{StaticResource Icon.Scale}" Style="{StaticResource WideCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,0,0,6"
                                   Text="What a sale at each price you have set would leave over everything spent, before closing costs. Set the prices in the Value card."/>
                        <DataGrid ItemsSource="{Binding Model.PriceScenarios}" FontSize="13" MinRowHeight="30" IsHitTestVisible="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Price" Binding="{Binding Label}" Width="*"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Price, StringFormat={}{0:C}}" Width="130" ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="Profit" Binding="{Binding Profit, StringFormat={}{0:C}}" Width="130" ElementStyle="{StaticResource NumericCellStyle}" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Return" Binding="{Binding RoiPercent, StringFormat={}{0:N0}%, TargetNullValue=''}" Width="100" ElementStyle="{StaticResource NumericCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="Owner financing" Tag="{StaticResource Icon.Calendar}" Style="{StaticResource WideCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Financing price" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding FinancingPrice, StringFormat=N2, TargetNullValue=''}" Width="140" DockPanel.Dock="Left" Margin="0,0,12,0" Tag="asking price"
                                     ToolTip="Leave empty to use the asking price, or the market value when there is no asking price"/>
                            <TextBlock Text="{Binding FinancingBasisText}" Style="{StaticResource Theme.Dialog.Text.Small}" VerticalAlignment="Center"/></DockPanel>
                        <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,2,0,6" Text="The offers. Change any number; the payments below follow when you leave the row."/>
                        <DataGrid x:Name="TiersGrid" ItemsSource="{Binding Model.FinancingTiers}" Style="{StaticResource EditGrid}" RowEditEnding="OnRowEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Offer" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Down %" Binding="{Binding DownPercent, StringFormat=0.##}" Width="110" ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="APR %" Binding="{Binding Apr, StringFormat=0.00}" Width="110" ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="Months" Binding="{Binding Months}" Width="110" ElementStyle="{StaticResource NumericCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid ItemsSource="{Binding Model.FinancingQuotes}" FontSize="13" MinRowHeight="30" IsHitTestVisible="False" Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Offer" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Down payment" Binding="{Binding DownPayment, StringFormat={}{0:C}}" Width="120" ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="Financed" Binding="{Binding Financed, StringFormat={}{0:C}}" Width="110" ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="Monthly" Binding="{Binding Monthly, StringFormat={}{0:C}}" Width="110" ElementStyle="{StaticResource NumericCellStyle}" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Total received" Binding="{Binding TotalReceived, StringFormat={}{0:C}}" Width="130" ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="Interest" Binding="{Binding TotalInterest, StringFormat={}{0:C}}" Width="110" ElementStyle="{StaticResource NumericCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,8,0,4" Text="Cash option: 0% interest for a buyer who pays the full price at closing. No prepayment penalty on any offer."/>
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Use as my defaults" Style="{StaticResource Theme.Dialog.Button.Link}" Command="{Binding DataContext.SaveTiersAsDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="New properties will start with these offers"/>
                                <Button Content="Term sheet" Tag="{StaticResource Icon.Html}" Style="{StaticResource Theme.Dialog.Button.Outline}" Padding="12,5" Command="{Binding DataContext.ExportTermSheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Save the term sheet as a web page and open it; print it to PDF from the browser"/>
                            </StackPanel>
                            <TextBox Text="{Binding DataContext.ContactLine, RelativeSource={RelativeSource AncestorType=UserControl}}" Tag="Line under the logo on the term sheet: city, e-mail, phone"
                                     ToolTip="Shown under the logo on every term sheet. Saved in the app's settings, not with this property."/>
                        </DockPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="Sale readiness" Tag="{StaticResource Icon.Check}" Style="{StaticResource WideCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding ChecklistProgress}" Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,0,0,6"/>
                        <DataGrid x:Name="ChecklistGrid" ItemsSource="{Binding Model.SaleChecklist}" Style="{StaticResource EditGrid}" CanUserAddRows="False" CanUserDeleteRows="False"
                                  MaxHeight="520" RowEditEnding="OnRowEditEnding">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Done" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><CheckBox IsChecked="{Binding Done, UpdateSourceTrigger=PropertyChanged}" Click="OnChecklistClick" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Step" Binding="{Binding Title}" Width="2*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="Offices and contacts" Tag="{StaticResource Icon.City}" Style="{StaticResource WideCard}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding OfficeLinks}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Key}" Style="{StaticResource Theme.Dialog.Button.Link}" Margin="0,0,10,6" CommandParameter="{Binding Value}"
                                            Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,0,0,6" Text="Who to call: Register of Deeds, Treasurer, Planning and Zoning, title companies."/>
                        <DataGrid x:Name="ContactsGrid" ItemsSource="{Binding Model.Contacts}" Style="{StaticResource EditGrid}" RowEditEnding="OnRowEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Office or company" Binding="{Binding Office}" Width="*"/>
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="150"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="Listings" Tag="{StaticResource Icon.Web}" Style="{StaticResource WideCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,0,0,6" Text="Where it is advertised. Add a new line for a price change, so the history stays."/>
                        <DataGrid x:Name="ListingsGrid" ItemsSource="{Binding Model.Listings}" Style="{StaticResource EditGrid}" RowEditEnding="OnRowEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="100"/>
                                <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="160"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2, TargetNullValue=''}" Width="110" ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="Link" Binding="{Binding Url}" Width="*"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="Buyers" Tag="{StaticResource Icon.Person}" Style="{StaticResource WideCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Add the neighbors" Style="{StaticResource Theme.Dialog.Button.Link}" Command="{Binding DataContext.NeighborsToLeadsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="Every neighbor not already listed here becomes a lead to contact"/>
                            <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" VerticalAlignment="Center" Text="Everyone who asked or made an offer. Contact is a phone, e-mail or address; Fin. means they want owner financing."/>
                        </DockPanel>
                        <DataGrid x:Name="BuyersGrid" ItemsSource="{Binding Model.Buyers}" Style="{StaticResource EditGrid}" RowEditEnding="OnRowEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="80"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.3*"/>
                                <DataGridTextColumn Header="Contact" Binding="{Binding Contact}" Width="1.3*"/>
                                <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type}" ItemsSource="{x:Static vm:MyPropertiesViewModel.BuyerTypes}" Width="90"/>
                                <DataGridTextColumn Header="Offer" Binding="{Binding Offer, StringFormat=N2, TargetNullValue=''}" Width="80" ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridCheckBoxColumn Header="Fin." Binding="{Binding Financed}" Width="46"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="The sale" Tag="{StaticResource Icon.Save}" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Sale date" Style="{StaticResource Label}"/><TextBox Text="{Binding SaleDate, StringFormat=d, TargetNullValue=''}" Tag="m/d/yyyy"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Sale price" Style="{StaticResource Label}"/><TextBox Text="{Binding SalePrice, StringFormat=N2, TargetNullValue=''}"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Closing costs" Style="{StaticResource Label}"/><TextBox Text="{Binding SaleClosingCosts, StringFormat=N2}" ToolTip="Title, transfer tax, commission: everything taken out of the price"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Net proceeds" Style="{StaticResource Label}"/><TextBlock Text="{Binding Model.NetProceeds, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Computed}" FontWeight="Normal"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Net profit" Style="{StaticResource Label}"/><TextBlock Text="{Binding Model.NetProfit, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Computed}"/></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Return" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Computed}" FontWeight="Normal">
                                <Run Text="{Binding Model.NetRoiPercent, StringFormat={}{0:N0}%, TargetNullValue='–', Mode=OneWay}"/><Run Text="{Binding Model.AnnualizedRoiPercent, StringFormat='  ·  {0:N0}% a year', TargetNullValue='', Mode=OneWay}"/>
                            </TextBlock></DockPanel>
                        <DockPanel Style="{StaticResource Field}"><TextBlock Text="Held" Style="{StaticResource Label}"/><TextBlock Text="{Binding HeldText}" Style="{StaticResource Computed}" FontWeight="Normal"/></DockPanel>
                        <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" Text="Set the status in the Value and pricing card to Sold (cash) or Sold (financed) when it closes."/>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="Marketing and notes" Tag="{StaticResource Icon.Document}" Style="{StaticResource WideCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Copy brief" Tag="{StaticResource Icon.Copy}" Style="{StaticResource Theme.Dialog.Button.Outline}" Padding="12,5" Command="{Binding DataContext.CopyBriefCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Copy this property's facts, worded for Claude's property-intel skill"/>
                                <Button Content="Paste results" Tag="{StaticResource Icon.Paste}" Style="{StaticResource Theme.Dialog.Button.Outline}" Padding="12,5" Command="{Binding DataContext.PasteResearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Add the JSON block Claude wrote: texts, prices, neighbors, contacts, buyers. Values you typed are kept."/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Text="Let Claude write these: Copy brief, paste it into Claude, copy the JSON block it ends with, then Paste results."/>
                        </DockPanel>
                        <TextBlock Text="Notes" Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Notes}" Style="{StaticResource LongText}"/>
                        <TextBlock Text="Overview" Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding Overview}" Style="{StaticResource LongText}"/>
                        <TextBlock Text="Location overview" Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding LocationOverview}" Style="{StaticResource LongText}"/>
                        <TextBlock Text="Listing ad" Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding ListingAd}" Style="{StaticResource LongText}"/>
                    </StackPanel>
                </HeaderedContentControl>
            </WrapPanel>
        </ScrollViewer>

        <!-- Row 3: what happened last -->
        <TextBlock Grid.Row="3" Text="{Binding Status}" Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
