                            <HeaderedContentControl Tag="{StaticResource Icon.Building}" Style="{StaticResource Card}">
                                <HeaderedContentControl.Header>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Edit" Tag="{StaticResource Icon.Edit}" Style="{StaticResource EditButton}" CommandParameter="Value"
                                                Command="{Binding DataContext.EditSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <TextBlock Text="Value &amp; Pricing" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Normal}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Tertiary}"/>
                                    </DockPanel>
                                </HeaderedContentControl.Header>
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Total spent" Style="{StaticResource Label}"/><TextBlock Text="{Binding Model.TotalSpent, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Value}" FontWeight="Bold"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Market value" Style="{StaticResource Label}"/><TextBlock Text="{Binding MarketValue, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Minimum sale" Style="{StaticResource Label}"/><TextBlock Text="{Binding MinimumSaleText}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Comps" Style="{StaticResource Label}"/><TextBlock Text="{Binding CompsSummary}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Asking price" Style="{StaticResource Label}"/><TextBlock Text="{Binding AskingPrice, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Negotiation target" Style="{StaticResource Label}"/><TextBlock Text="{Binding NegotiationTarget, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Quick-sale price" Style="{StaticResource Label}"/><TextBlock Text="{Binding QuickSalePrice, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Conservative value" Style="{StaticResource Label}"/><TextBlock Text="{Binding ConservativeValue, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                    <DockPanel Style="{StaticResource Row}"><TextBlock Text="Optimistic value" Style="{StaticResource Label}"/><TextBlock Text="{Binding OptimisticValue, StringFormat={}{0:C}, TargetNullValue='–'}" Style="{StaticResource Value}"/></DockPanel>
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </Grid>

                    <Expander Header="Expenses" Tag="{StaticResource Icon.List.Numbered}" HeaderStringFormat="{Binding ExpensesSubtitle}" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,0,0,6"
                                       Text="Everything spent after the purchase: tax bills, grass cuts, signs. Type in the empty last row to add a line; select a row and press Delete to remove it."/>
                            <DataGrid x:Name="ExpensesGrid" ItemsSource="{Binding Model.Expenses}" Style="{StaticResource EditGrid}" RowEditEnding="OnRowEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="100"/>
                                    <DataGridComboBoxColumn Header="Category" SelectedItemBinding="{Binding Category}" ItemsSource="{x:Static vm:MyPropertiesViewModel.ExpenseCategories}" Width="150"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="100" ElementStyle="{StaticResource NumericCellStyle}"/>
                                    <DataGridTextColumn Header="Tax year" Binding="{Binding TaxYear, TargetNullValue=''}" Width="80"/>
                                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Model.ExpensesTotal, StringFormat=Total {0:C}}" Style="{StaticResource Computed}" Margin="12,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding ExpensesByCategory}" Style="{StaticResource Theme.Dialog.Text.Small}"/>
                                    <TextBlock Text="{Binding ExpensesByYear}" Style="{StaticResource Theme.Dialog.Text.Small}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Neighbors" Tag="{StaticResource Icon.Person}" HeaderStringFormat="{Binding NeighborsSubtitle}" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,0,0,6" Text="The owners next door: often the first buyers to call."/>
                            <DataGrid x:Name="NeighborsGrid" ItemsSource="{Binding Model.Neighbors}" Style="{StaticResource EditGrid}" RowEditEnding="OnRowEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"/>
                                    <DataGridTextColumn Header="Property address" Binding="{Binding PropertyAddress}" Width="*"/>
                                    <DataGridTextColumn Header="Mailing address" Binding="{Binding MailingAddress}" Width="*"/>
                                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Profit at a glance" Tag="{StaticResource Icon.Scale}" HeaderStringFormat="What a sale at each price you have set would leave over everything spent" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,0,0,6"
                                       Text="What a sale at each price you have set would leave over everything spent, before closing costs. Set the prices in the Value card."/>
                            <DataGrid ItemsSource="{Binding Model.PriceScenarios}" FontSize="13" MinRowHeight="30" IsHitTestVisible="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Price" Binding="{Binding Label}" Width="*"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Price, StringFormat={}{0:C}}" Width="130" ElementStyle="{StaticResource NumericCellStyle}"/>
                                    <DataGridTextColumn Header="Profit" Binding="{Binding Profit, StringFormat={}{0:C}}" Width="130" ElementStyle="{StaticResource NumericCellStyle}" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Return" Binding="{Binding RoiPercent, StringFormat={}{0:N0}%, TargetNullValue=''}" Width="100" ElementStyle="{StaticResource NumericCellStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Owner financing" Tag="{StaticResource Icon.Calendar}" HeaderStringFormat="{Binding FinancingBasisText}" Style="{StaticResource Section}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Field}"><TextBlock Text="Financing price" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding FinancingPrice, StringFormat=N2, TargetNullValue=''}" Width="140" DockPanel.Dock="Left" Margin="0,0,12,0" Tag="asking price"
                                         ToolTip="Leave empty to use the asking price, or the market value when there is no asking price"/>
                                <TextBlock Text="{Binding FinancingBasisText}" Style="{StaticResource Theme.Dialog.Text.Small}" VerticalAlignment="Center"/></DockPanel>
                            <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,2,0,6" Text="The offers. Change any number; the payments below follow when you leave the row."/>
                            <DataGrid x:Name="TiersGrid" ItemsSource="{Binding Model.FinancingTiers}" Style="{StaticResource EditGrid}" RowEditEnding="OnRowEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Offer" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Down %" Binding="{Binding DownPercent, StringFormat=0.##}" Width="110" ElementStyle="{StaticResource NumericCellStyle}"/>
                                    <DataGridTextColumn Header="APR %" Binding="{Binding Apr, StringFormat=0.00}" Width="110" ElementStyle="{StaticResource NumericCellStyle}"/>
                                    <DataGridTextColumn Header="Months" Binding="{Binding Months}" Width="110" ElementStyle="{StaticResource NumericCellStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid ItemsSource="{Binding Model.FinancingQuotes}" FontSize="13" MinRowHeight="30" IsHitTestVisible="False" Margin="0,10,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Offer" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Down payment" Binding="{Binding DownPayment, StringFormat={}{0:C}}" Width="120" ElementStyle="{StaticResource NumericCellStyle}"/>
                                    <DataGridTextColumn Header="Financed" Binding="{Binding Financed, StringFormat={}{0:C}}" Width="110" ElementStyle="{StaticResource NumericCellStyle}"/>
                                    <DataGridTextColumn Header="Monthly" Binding="{Binding Monthly, StringFormat={}{0:C}}" Width="110" ElementStyle="{StaticResource NumericCellStyle}" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Total received" Binding="{Binding TotalReceived, StringFormat={}{0:C}}" Width="130" ElementStyle="{StaticResource NumericCellStyle}"/>
                                    <DataGridTextColumn Header="Interest" Binding="{Binding TotalInterest, StringFormat={}{0:C}}" Width="110" ElementStyle="{StaticResource NumericCellStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" Margin="0,8,0,4" Text="Cash option: 0% interest for a buyer who pays the full price at closing. No prepayment penalty on any offer."/>
                            <DockPanel Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Use as my defaults" Style="{StaticResource Theme.Dialog.Button.Link}" Command="{Binding DataContext.SaveTiersAsDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="New properties will start with these offers"/>
                                    <Button Content="Term sheet" Tag="{StaticResource Icon.Html}" Style="{StaticResource Theme.Dialog.Button.Outline}" Padding="12,5" Command="{Binding DataContext.ExportTermSheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="Save the term sheet as a web page and open it; print it to PDF from the browser"/>
                                </StackPanel>
                                <TextBox Text="{Binding DataContext.ContactLine, RelativeSource={RelativeSource AncestorType=UserControl}}" Tag="Line under the logo on the term sheet: city, e-mail, phone"
                                         ToolTip="Shown under the logo on every term sheet. Saved in the app's settings, not with this property."/>
                            </DockPanel>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Sale readiness" Tag="{StaticResource Icon.Check}" HeaderStringFormat="{Binding ChecklistProgress}" Style="{StaticResource Section}">
