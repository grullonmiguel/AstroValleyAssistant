                                            ToolTip="Copy the deed, tax bills or photos into this property's folder"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Theme.Dialog.Text.Small}" VerticalAlignment="Center" Text="The deed, tax bills, photos. Click one to open it. To remove one, delete it in the folder."/>
                            </DockPanel>
