                                <DockPanel Style="{StaticResource Field}"><TextBlock Text="APR %" Style="{StaticResource Label}"/><TextBox Text="{Binding NoteApr, StringFormat=0.00, TargetNullValue=''}"/></DockPanel>
                                <DockPanel Style="{StaticResource Field}" Margin="0,0,12,6"><TextBlock Text="Months" Style="{StaticResource Label}"/><TextBox Text="{Binding NoteMonths, TargetNullValue=''}"/></DockPanel>
                                <DockPanel Style="{StaticResource Field}"><TextBlock Text="First payment due" Style="{StaticResource Label}"/><TextBox Text="{Binding NoteFirstPayment, StringFormat=d, TargetNullValue=''}" Tag="m/d/yyyy"/></DockPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding NoteSummary}" Style="{StaticResource Computed}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <DataGrid x:Name="PaymentsGrid" ItemsSource="{Binding Model.Payments}" Style="{StaticResource EditGrid}" RowEditEnding="OnRowEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date received" Binding="{Binding Date, StringFormat=d}" Width="130"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="130" ElementStyle="{StaticResource NumericCellStyle}"/>
                                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Documents and photos" Tag="{StaticResource Icon.Document}" HeaderStringFormat="The deed, tax bills and pictures, kept in this property's own folder" Style="{StaticResource Section}">
