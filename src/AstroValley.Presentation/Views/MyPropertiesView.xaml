                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Theme.Dialog.Button.Link}" Margin="0,0,10,10" Padding="0" CommandParameter="{Binding Path}" ToolTip="{Binding Name}"
                                                Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <StackPanel Width="120">
                                                <Border Height="80" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Brush.Background.Hover}">
                                                    <Grid>
                                                        <Path Style="{StaticResource Theme.Dialog.Icon}" Data="{StaticResource Icon.Document}" Width="28" Height="28" Opacity="0.6"/>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Normal" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" HorizontalAlignment="Center"/>
