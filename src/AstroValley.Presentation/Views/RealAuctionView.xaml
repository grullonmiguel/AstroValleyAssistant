<UserControl x:Class="AstroValley.Presentation.Views.RealAuctionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AstroValley.Presentation.Views"
             xmlns:control="clr-namespace:AstroValley.Presentation.Themes.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
       
        <DataTemplate x:Key="StatusBadgeTemplate">
            <Border x:Name="StatusBadge" 
                    CornerRadius="4" 
                    Padding="6 4" 
                    HorizontalAlignment="Center"
                    Background="Transparent">
                <TextBlock x:Name="StatusText" 
                       Text="--" 
                       Foreground="Gray" 
                       FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Loading">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource Brush.Status.Info}"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Brush.Status.Info.Foreground}"/>
                    <Setter TargetName="StatusText" Property="Text" Value="● Loading"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Status}" Value="Success">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource Brush.Status.Success}"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Brush.Status.Success.Foreground}"/>
                    <Setter TargetName="StatusText" Property="Text" Value="✔ Success"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Status}" Value="MultipleMatches">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource Brush.Status.Warning}"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Brush.Status.Warning.Foreground}"/>
                    <Setter TargetName="StatusText" Property="Text" Value="⚠ Multiple"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Status}" Value="NotFound">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource Brush.Status.Danger}"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Brush.Status.Danger.Foreground}"/>
                    <Setter TargetName="StatusText" Property="Text" Value="? Not Found"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource Brush.Status.Danger}"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Brush.Status.Danger.Foreground}"/>
                    <Setter TargetName="StatusText" Property="Text" Value="✘ Failed"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Status}" Value="RateLimited">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource Brush.Status.Warning}"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Brush.Status.Warning.Foreground}"/>
                    <Setter TargetName="StatusText" Property="Text" Value="⏱ Rate Limited"/>
                </DataTrigger>

            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="NumericCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource ViewSlideInFromTopStyle}" Margin="0 0 16 16" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Brush.Accent}"  
                IsEnabled="{Binding IsScraping, Converter={StaticResource BooleanInvertConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource Brush.Accent.Tertiary}" Padding="8 10">
                    <StackPanel>
                        <control:IconTextButton Text="{Binding CurrentAuctionAlias}" FontSize="14"
                                                Icon="{StaticResource Icon.Web.Search}"
                                                Command="{Binding OpenRealAuctionCommand}" 
                                                Style="{StaticResource Theme.Button.IconText.Sidebar}" />
                        <!-- Stale date warning -->
                        <TextBlock Text="⚠ Auction date has passed"
                                   FontSize="10" Margin="4 4 4 0"
                                   Foreground="#FFB74D"
                                   Visibility="{Binding IsAuctionDateStale, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Recent URLs -->
                <Border Grid.Row="1" Padding="8 8 8 0"
                        Visibility="{Binding RecentAuctionUrls.Count, Converter={StaticResource NullToBooleanConverter}}">
                    <StackPanel>
                        <TextBlock Text="Recent Auctions" Style="{StaticResource Theme.TextBlock.Sidebar.Title}" Margin="8 0 0 4"/>
                        <ListBox ItemsSource="{Binding RecentAuctionUrls}"
                                 Background="Transparent" BorderThickness="0" MaxHeight="200"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <!-- Border-less template: the default one paints a white disabled background while the sidebar is disabled during a scrape. -->
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="RecentRow" Background="Transparent" ToolTip="{Binding Tooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{Binding Alias}"
                                                Command="{Binding DataContext.SelectRecentUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Left"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource Theme.Button.Hyperlink}"
                                                FontSize="11"
                                                Padding="4 2"/>
                                        <Button x:Name="RemoveButton" Grid.Column="1" ToolTip="Remove from recent" Opacity="0"
                                                Command="{Binding DataContext.RemoveRecentUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Theme.Button.Hyperlink.Icon}">
                                            <Path Width="12" Height="12" Stretch="Uniform"
                                                  Data="{StaticResource Icon.Delete}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <!-- Show the trash can only on hover or keyboard focus to cut clutter -->
                                        <Trigger SourceName="RecentRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RemoveButton" Property="Opacity" Value="1"/>
                                        </Trigger>
                                        <Trigger SourceName="RemoveButton" Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="RemoveButton" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Padding="16 8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <!-- ========== PROPERTY DETAILS AREA ========== -->
                        <Border Grid.Row="1" Visibility="{Binding IsResultButtonsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <local:PropertyDetailsControl DataContext="{Binding ElementName=AuctionGrid, Path=SelectedItem}" Focusable="False"/>
                        </Border>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- Auction Data -->
        <Grid Grid.Column="1" Margin="16 0 0 0 ">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="1" Background="{StaticResource Brush.Accent}" Padding="16 0" Height="50">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.Text.Light}" VerticalAlignment="Center" />


                    
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsScrapeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <control:IconTextButton 
                            Height="42"
                            Margin="0 0 8 0"
                            Text="Navigate to Real Auction"
                            Icon="{StaticResource Icon.Web.Search}"
                            Command="{Binding OpenWebNavigationCommand}"
                            IsEnabled="{Binding IsScraping, Converter={StaticResource BooleanInvertConverter}}"/>
                        <Button VerticalAlignment="Center"
                            Content="Scrape Real Auction"
                            Command="{Binding LoadRealAuctionCommand}"
                            ToolTipService.ShowOnDisabled="True"
                            IsEnabled="{Binding IsScraping, Converter={StaticResource BooleanInvertConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Theme.Button.Scrape}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuctionDateStale}" Value="True">
                                            <Setter Property="ToolTip" Value="This auction date has passed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsResultButtonsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <!-- Cancel Button -->
                        <control:IconTextButton Text="Cancel" Icon="{StaticResource Icon.Cancel}" 
                                                Command="{Binding CancelCommand}" Margin="0 0 8 0" 
                                                Visibility="{Binding IsScraping, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        
                        <!-- Map Button -->
                        <control:IconTextButton Text="Map" Icon="{StaticResource Icon.MapOutline}" 
                                                Command="{Binding ViewInMapCommand}" Margin="0 0 8 0" 
                                                Visibility="{Binding IsScraping, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"/>

                        <!-- Clear Button -->
                        <control:IconTextButton Text="Clear" Icon="{StaticResource Icon.Delete}" 
                                                Command="{Binding ClearCommand}" Margin="0 0 8 0" 
                                                Visibility="{Binding IsScraping, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"/>
                        
                        <!-- Copy Button -->
                        <control:IconTextButton Text="Copy" Icon="{StaticResource Icon.Copy}" 
                                                Command="{Binding CopyToClipboardCommand}" Margin="0 0 8 0" 
                                                Visibility="{Binding IsScraping, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"/>

                        <!-- Scrape Regrid Data Button -->
                        <Button Content="Scrape Regrid" Style="{StaticResource Theme.Button.Scrape}" Command="{Binding EnrichWithRegridCommand}" />
                    </StackPanel>
                    
                </Grid>
            </Border>

            <!-- Row 1: Multiple Matches Banner -->
            <local:MultipleMatchesBanner MatchCount="{Binding PropertySelected.Matches.Count, Mode=OneWay}" 
                                                ParcelId="{Binding PropertySelected.ParcelId, Mode=OneWay}"
                                                ViewMatchesCommand="{Binding ViewMatchesCommand}"
                                                ViewMatchesCommandParameter="{Binding PropertySelected}"
                                                Visibility="{Binding PropertySelected.HasMultipleMatches, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
            
            <!-- Row 2: Parcel List -->
            <FrameworkElement Grid.Row="2" x:Name="FrameWorkElementProxy" Visibility="Collapsed"/>
            <DataGrid Grid.Row="2" x:Name="AuctionGrid" ItemsSource="{Binding PropertyRecords}" SelectedItem="{Binding PropertySelected, Mode=TwoWay}"
                      FontSize="13" MinRowHeight="38">
                <!-- Local RowStyle replaces the global one, so its hover/selected triggers are repeated here (must stay after the status triggers to win). -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
                        <Setter Property="BorderThickness" Value="4 0 0 0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="MultipleMatches">
                                <Setter Property="Background" Value="#30FFB74D"/>
                                <Setter Property="BorderBrush" Value="#FFB74D"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="NotFound">
                                <Setter Property="Background" Value="#30EF5350"/>
                                <Setter Property="BorderBrush" Value="#EF5350"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                <Setter Property="Background" Value="#30FF1744"/>
                                <Setter Property="BorderBrush" Value="#FF1744"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="RateLimited">
                                <Setter Property="Background" Value="#30FFD700"/>
                                <Setter Property="BorderBrush" Value="#FFD700"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Secondary}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status" Width="95" CellTemplate="{StaticResource StatusBadgeTemplate}"/>
                    <DataGridTextColumn Header="Parcel ID" Binding="{Binding ParcelId}" Width="Auto"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
                    <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="*"/>
                    <DataGridTextColumn Header="Assessed" Binding="{Binding AssessedValue, StringFormat={}{0:C}}" Width="100" ElementStyle="{StaticResource NumericCellStyle}"/>
                    <DataGridTextColumn Header="Opening Bid" Binding="{Binding Bid, StringFormat={}{0:C}}" Width="110" ElementStyle="{StaticResource NumericCellStyle}"/>
                    <DataGridTextColumn Header="Acres" Binding="{Binding Acres, StringFormat={}{0:N4}}" Width="80" ElementStyle="{StaticResource NumericCellStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <local:ScrapeOverlay Grid.Row="2"/>
        </Grid>
    </Grid>
</UserControl>
