<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A style can only resolve StaticResource keys from its own file and the files merged into it, so merge the tokens. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!-- Bottom status strip inside the content area. -->
    <Style x:Key="StatusBarBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    </Style>

    <Style x:Key="StatusBarTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

</ResourceDictionary>
