<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- DATA GRID STYLES -->

    <!-- A list the user reads and selects from, never types into. -->
    <Style x:Key="ReadOnlyDataGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Money, acres and other numbers line up on the right. -->
    <Style x:Key="NumericCellTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Lookup status of a row (PropertyDataViewModel.Status): a small colored pill. -->
    <DataTemplate x:Key="LookupStatusBadgeTemplate">
        <Border x:Name="Badge" CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,2" HorizontalAlignment="Left" Background="Transparent">
            <TextBlock x:Name="Label" Text="Pending" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{StaticResource AppSubtleForegroundBrush}" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Loading">
                <Setter TargetName="Label" Property="Text" Value="Looking up" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Success">
                <Setter TargetName="Label" Property="Text" Value="Found" />
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                <Setter TargetName="Badge" Property="Background" Value="{StaticResource SuccessSubtleBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="MultipleMatches">
                <Setter TargetName="Label" Property="Text" Value="Multiple" />
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WarningBrush}" />
                <Setter TargetName="Badge" Property="Background" Value="{StaticResource WarningSubtleBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="RateLimited">
                <Setter TargetName="Label" Property="Text" Value="Rate limited" />
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WarningBrush}" />
                <Setter TargetName="Badge" Property="Background" Value="{StaticResource WarningSubtleBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="NotFound">
                <Setter TargetName="Label" Property="Text" Value="Not found" />
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                <Setter TargetName="Badge" Property="Background" Value="{StaticResource ErrorSubtleBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Error">
                <Setter TargetName="Label" Property="Text" Value="Failed" />
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                <Setter TargetName="Badge" Property="Background" Value="{StaticResource ErrorSubtleBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
