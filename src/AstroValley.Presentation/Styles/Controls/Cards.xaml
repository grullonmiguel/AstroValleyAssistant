<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- CARD AND CHIP STYLES -->

    <!-- A block of related controls on a page (a list source, a details panel). -->
    <Style x:Key="SectionCardStyle" TargetType="{x:Type materialDesign:Card}" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="{StaticResource SectionMargin}" />
    </Style>

    <!-- A card that stands out from the ones around it (e.g. "what you searched for" above a list of matches). -->
    <Style x:Key="HighlightCardStyle" TargetType="{x:Type materialDesign:Card}" BasedOn="{StaticResource SectionCardStyle}">
        <Setter Property="Background" Value="{DynamicResource SecondaryEmphasisBrush}" />
    </Style>

    <!--
        FLYOUT: a panel floating over a page, opened from a button above it (Parcel Lookup's Auction Lists).
        A StackPanel with FlyoutPanelStyle holds a Path with FlyoutTailStyle (the pointer up at the button) and a Card with FlyoutCardStyle.
        Show / hide the panel with Visibility; it slides in from the right as it appears. Give the panel a TranslateTransform as its
        RenderTransform (the animation moves it; a transform set in a style is frozen and cannot be animated).
    -->
    <Style x:Key="FlyoutCardStyle" TargetType="{x:Type materialDesign:Card}" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
        <Setter Property="Width" Value="{StaticResource FlyoutWidth}" />
        <Setter Property="Padding" Value="16,16,8,20" />
        <Setter Property="UniformCornerRadius" Value="14" />
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp8" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
    </Style>

    <!-- The flyout's pointer: a small triangle on top of the card, in the card's color, under the button that opened it. -->
    <Style x:Key="FlyoutTailStyle" TargetType="{x:Type Path}">
        <Setter Property="Data" Value="M0,10 L10,0 L20,10 Z" />
        <Setter Property="Fill" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="{StaticResource FlyoutTailMargin}" />
    </Style>

    <Style x:Key="FlyoutPanelStyle" TargetType="{x:Type StackPanel}">
        <Setter Property="Margin" Value="{StaticResource FlyoutPanelMargin}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" From="40" To="0"
                                             Duration="{StaticResource SidebarAnimationDuration}" EasingFunction="{StaticResource StandardEase}" />
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                             Duration="{StaticResource SidebarAnimationDuration}" EasingFunction="{StaticResource StandardEase}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A card that fills its cell and lets its content (a grid) handle scrolling. -->
    <Style x:Key="FillCardStyle" TargetType="{x:Type materialDesign:Card}" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- The strip across the top of a FillCard (a count on the left, actions on the right). -->
    <Style x:Key="CardHeaderStyle" TargetType="{x:Type DockPanel}">
        <Setter Property="Margin" Value="16,4,8,4" />
    </Style>

    <!-- Rounded frame for a picture (aerial photo of a parcel). -->
    <Style x:Key="ThumbnailBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="{StaticResource ThumbnailHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Background" Value="{StaticResource AppDividerBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
</ResourceDictionary>
