<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Brushes resolve the colors with StaticResource, so this file merges the colors itself. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        FROZEN BRUSHES for the fixed colors (see Colors.xaml). Frozen brushes are cheaper to render
        and safe to share across threads.

        Brand brushes are intentionally NOT defined here. Use Material Design's dynamic brushes with
        DynamicResource so they follow the selected color:
            MaterialDesign.Brush.Primary, MaterialDesign.Brush.Primary.Foreground,
            MaterialDesign.Brush.Primary.Light, MaterialDesign.Brush.Primary.Dark,
            MaterialDesign.Brush.Secondary, MaterialDesign.Brush.Secondary.Foreground
    -->
    <!-- Defaults only: ThemeService replaces these two with the selected primary's companions (AppDefaults.Palettes). Use DynamicResource. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" po:Freeze="True" Color="#EDEBF2" />
    <SolidColorBrush x:Key="SecondaryEmphasisBrush" po:Freeze="True" Color="#DBD8E9" />
    <SolidColorBrush x:Key="AppForegroundBrush" po:Freeze="True" Color="{StaticResource AppForegroundColor}" />
    <SolidColorBrush x:Key="AppSubtleForegroundBrush" po:Freeze="True" Color="{StaticResource AppSubtleForegroundColor}" />
    <SolidColorBrush x:Key="AppDividerBrush" po:Freeze="True" Color="{StaticResource AppDividerColor}" />

    <SolidColorBrush x:Key="SuccessBrush" po:Freeze="True" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" po:Freeze="True" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" po:Freeze="True" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="InfoBrush" po:Freeze="True" Color="{StaticResource InfoColor}" />

    <!-- Light tints of the status colors, for badge backgrounds. -->
    <SolidColorBrush x:Key="SuccessSubtleBrush" po:Freeze="True" Color="{StaticResource SuccessColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="WarningSubtleBrush" po:Freeze="True" Color="{StaticResource WarningColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="ErrorSubtleBrush" po:Freeze="True" Color="{StaticResource ErrorColor}" Opacity="0.12" />

    <SolidColorBrush x:Key="CaptionCloseHoverBrush" po:Freeze="True" Color="{StaticResource CaptionCloseHoverColor}" />

    <!-- Translucent white overlays used on top of the primary-colored sidebar. -->
    <SolidColorBrush x:Key="OnPrimaryHoverBrush" po:Freeze="True" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="OnPrimarySelectedBrush" po:Freeze="True" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="OnPrimaryOutlineBrush" po:Freeze="True" Color="#4DFFFFFF" />

</ResourceDictionary>
