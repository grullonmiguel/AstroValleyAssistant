<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        FIXED COLORS
        These never change at runtime. The switchable brand color (primary / secondary) is NOT here:
        it comes from Material Design and is set through IThemeService (default in AppDefaults.cs).
    -->
    <Color x:Key="AppForegroundColor">#212936</Color>
    <Color x:Key="AppSubtleForegroundColor">#6B7280</Color>
    <Color x:Key="AppDividerColor">#E5E7EB</Color>

    <Color x:Key="SuccessColor">#2E7D32</Color>
    <Color x:Key="WarningColor">#ED8B00</Color>
    <Color x:Key="ErrorColor">#D1031C</Color>

    <Color x:Key="CaptionCloseHoverColor">#E81123</Color>

</ResourceDictionary>
